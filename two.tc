#include pps/lrblib.tc
#include pps/library.tc

// ax + by = e   e.g. 45x -21y = 314
// cx + dy = f        -2x +13y = 11

input char c [ // get input
 printf "input %c : ",c
 return gn
 ]

abs int z [ // absolute value
 if z < 0 return -z
 else return z
 ]

main [
 printf "%ctwo.tc - lrb - 4/21/26%c%c",10,10,10
 int a,b,c,d,e,f,det,numx,numy
 char signx,signy

 a = input 'a'; b = input 'b'; c = input 'c'; d = input 'd'
 printf "%c",10
 e = input 'e'; f = input 'f'

 det = a*d - b*c

 if det == 0 [
  printf "%cDeterminant is zero - no unique solution.",10
  abort
  ]

 numx = d*e - b*f; numy = -c*e + a*f

 signx = signy = '-'
 if ( (numx <= 0) * (det < 0) + (numx >= 0) * (det > 0) ) signx = ' '
 if ( (numy <= 0) * (det < 0) + (numy >= 0) * (det > 0) ) signy = ' '

 numx = abs(numx); numy = abs(numy)
 det = abs(det)

 printf "%cSolution: %c",10,10
 printf "%cx = %c%d",10,signx,numx/det
 dpf numx%det,det,5
 printf "%cy = %c%d",10,signy,numy/det
 dpf numy%det,det,5
 ]

