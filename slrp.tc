#include pps/lrblib.tc
#include pps/library.tc

// slrp.tc - lrb - 8/7/18, 6/13/19, 8/16,17/22 (simple life random periodic)
// modified to detect periodicity // 9/27/26
// make sleep time controlable

char cell(15*15),dell(15*15),asterisk,space
int pop,dim
int pa(6) // array used to determine if periodic
int ai // array index

birth_death int rp,cp [
 int rw,cw,counter
 rw=rp-1
// no change is default
 dell(dim*rp+cp)=cell(dim*rp+cp)
 while rw<=rp+1 [
  cw=cp-1
  while cw<=cp+1 [
// legal?
   if ((rw>-1)*(rw<dim)*(cw>-1)*(cw<dim)) [
    if (cell(dim*rw+cw)==asterisk) counter=counter+1
    ]
   cw=cw+1
   ]
  rw=rw+1
  ]
// birth?
 if ((cell(dim*rp+cp)==space)) [
  if (counter==3) [dell(dim*rp+cp)=asterisk;pop=pop+1]
  ]
// death?
 else [
  if ((counter<3)+(counter>4)) [dell(dim*rp+cp)=space;pop=pop-1]
  ]
 ]

// cycle loads asterisks randomly initially.
// then, for each cell, display cell and call birth_death.
// remember last 5 population values.

cycle int bar [
 int i,r,c
 while r<dim [
  if bar==1 printf "%c             ",10
  c=0
  while c<dim [
   if bar==0 [
    i=random(0,5)
    if i==0 [cell(dim*r+c)=asterisk;pop=pop+1]
    else cell(dim*r+c)=space
    ]
   else [
    putchar cell(dim*r+c)
    birth_death r,c
    ]
   c=c+1
   ]
  r=r+1
  ]
  pa(ai)=pop
  ai=ai+1
  ai=ai%7
 ]

periodic [ // returns 6 if periodic
 int tf
 tf=(pa(0)==pa(1))
 tf=tf+(pa(1)==pa(2))
 tf=tf+(pa(2)==pa(3))
 tf=tf+(pa(3)==pa(4))
 tf=tf+(pa(4)==pa(5))
 tf=tf+(pa(5)==pa(6))
 return tf
 ]

main [
 int foo,s,c,rs,cs,delta,gen,gens,r1,r2
 char datebuff(20)
 pl "slrp.tc - lrb - 9/27/26"
 printf "%c%cEnter pause between generations e.g. 2 for 2 seconds : ",10,10
 s=gn
 dim=15
 asterisk='*';space=' '
 cdate datebuff
 // yyyy-mm-dd hh:mm:ss
 // 0123456789abcdefghi
 // hash the seconds to seed the random number generator
 r1=datebuff(17)-'0';r2=datebuff(18)-'0'
 r1=10*r1+r2
 if r1%2==0 r1=r1+1
 seed=last=r1
 cycle 0 // load board
 ai=0
 printf "generations? ";gens=gen=gn
 while gen [
  cdate datebuff
  printf "%c%cpopulation: %d generation: %d time: %s%c",10,10,pop,gens-gen+1,datebuff,10
  gen=gen-1
  sleep s
// display and update the array
  cycle 1;strcpy cell,dell
  foo=periodic()
  if (foo==6) [
   printf("%cperiodic",10);sleep 4;abort
   ]
  ]
 ]
