#include pps/lrblib.tc
#include pps/library.tc

// slrp.tc - lrb - 8/7/18, 6/13/19, 8/16,17/22 (simple life random periodic)
// modified to detect periodicity // 9/27/26
// make sleep time controlable

char cell(15*15),dell(15*15),asterisk,space;int pop

birth_death int rp,cp [
 int rw,cw,counter
 rw=rp-1
// no change is default
 dell(dim*rp+cp)=cell(dim*rp+cp)
 while rw<=rp+1 [
  cw=cp-1
  while cw<=cp+1 [
// legal?
   if ((rw>-1)*(rw<dim)*(cw>-1)*(cw<dim)) [
    if (cell(dim*rw+cw)==asterisk) counter=counter+1
    ]
   cw=cw+1
   ]
  rw=rw+1
  ]
// birth?
 if ((cell(dim*rp+cp)==space)) [
  if (counter==3) [dell(dim*rp+cp)=asterisk;pop=pop+1]
  ]
// death?
 else [
  if ((counter<3)+(counter>4)) [dell(dim*rp+cp)=space;pop=pop-1]
  ]
 ]

int pa(4) // periodic array
int ai // array index

cycle int foo [
 int i,r,c
 while r<dim [
  if foo==1 printf "%c             ",10
  c=0
  while c<dim [
   if foo==0 [
    i=random(0,5)
    if i==0 [cell(dim*r+c)='*';pop=pop+1]
    else cell(dim*r+c)=' '
    ]
   else [
    putchar cell(dim*r+c)
    birth_death r,c
    ]
   c=c+1
   ]
  r=r+1
  ]
  pa(ai)=pop
  ai=ai+1
  ai=ai%5
 ]

int dim

slrp [ // get desired delay in seconds
 printf("%cEnter pause between generations e.g. 2 for 2 seconds : ",10
 return gn
 ]

periodic [ // returns 4 if periodic
 int tf,ail
 tf=pa(0)==pa(1)
 tf=tf+(pa(1)==pa(2))
 tf=tf+(pa(2)==pa(3))
 tf=tf+(pa(3)==pa(4))
 return tf
 ]

main [ // 0
 int foo
 int s;s=slrp()
 int c,rs,cs,delta,gen,gens
 char datebuff(20)
 dim=15 // important!
 pl "slrp.tc - lrb - 9/27/26"
 asterisk='*';space=' '
 cdate datebuff
 // yyyy-mm-dd hh:mm:ss
 // 0123456789abcdefghi
 int r1,r2 // hash the seconds to seed the random number generator
 r1=datebuff(17)-'0';r2=datebuff(18)-'0'
 r1=10*r1+r2
 if r1%2==0 r1=r1+1
 seed=last=r1
 cycle 0 // clear the board
 ai=0
 printf "%cgenerations? ",10;gens=gen=gn
 while gen [ // main loop
  cdate datebuff
  printf "%c%cpopulation: %d generation: %d time: %s%c",10,10,pop,gens-gen+1,datebuff,10
  gen=gen-1
  sleep s
// display and update the array
  cycle 1;strcpy cell,dell
  foo=periodic()
//  printf ("%cfoo=%d%c%d %d %d %d %d ",10,foo,10,pa(0),pa(1),pa(2),pa(3),pa(4))
  if (foo==4) [ // 1
   // sak()
   printf("%cperiodic",10);sleep 4;abort
   ] // 1
  ] // main loop
 ] // 0

