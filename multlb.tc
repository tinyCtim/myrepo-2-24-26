
// mult.tc - lrb - 3/13/2010 - 9/22/25

sak [
 pl "Strike any key";pl "";getchar;
 MC 8,1;MC ' ',1
 ]

main [ // print multiplication tables from 1*1 up to 12*12
 int i,j
 i=1
 pl "mult.tc - 9/22/25 - lrb"
 while i<=12 [
  pl "";sak
  j=1
  while j<=12 [
   pl "";pn i;ps " *";pn j;ps " ="
   pn i*j
   j=j+1
   ]
  i=i+1
  ]
 pl ""
 ]
