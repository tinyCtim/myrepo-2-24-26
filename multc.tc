// lrb - Tuesday, September 25, 2025

ps char b(0) [int l;char c;while(c=b(l))[MC c,1;l=l+1]return l]
crlf [MC 10,1;MC 13,1]
pl char b(0) [crlf;ps b]
sak [pl "Press Enter ... ";crlf;getchar;MC 8,1;MC ' ',1]
getchar [return MC 2]
pn int n[MC ' ',1;MC n,14]

// From property file look up name and return value in buff.
// blen is the length of buff. Default is returned if file has
// no entry for name.

getproperty char file(0), name(0), buff(0); int blen; char default(0) [
 return MC file,name,buff,blen,default,116
 ]

color char c [
 if linux [
  MC '\'-'A',1;MC '\'-1,1;MC '3',1;MC c,1;MC 'm',1
  ]
 ]

hilo char c [
 if linux [
  MC '\'-'A',1;MC '\'-1,1;MC c,1;MC 'm',1
  ]
 ]

cursor_4 [ // steady underscore
 MC '\'-'A',1;MC '\'-1,1;MC '4',1;MC ' ',1;MC 'q',1
 ]

cursor_0 [ // blinking vertical
 MC '\'-'A',1;MC '\'-1,1;MC '0',1;MC ' ',1;MC 'q',1
 ]

int linux

multc [linux=1;mult]

mult [

 cursor_4
 char tbuff(30)
 getproperty "pps/version.prop","os =",tbuff,100,"..."
 if index(tbuff,100,"Linux",5) linux=1

 pl "";hilo '1';color '6';pl "multc.tc version 1.06c"
 pl "tiny-c program by chip bradley and lee bradley"
 pl "prints multiplication table"
 pl "from 0*0 to 9*9";color '7';pl ""

 int a,b,c

 while (a<=9) [
  b=0
  while (b<=9) [
   if ((c%10)==0) [hilo '0';sak;crlf]
   c=c+1
   hilo '1';pn a;ps " *";pn b;ps " =";pn a*b;pl ""
   b=b+1
   ]
  a=a+1
  ]

 hilo '0';color '7'

 ]
