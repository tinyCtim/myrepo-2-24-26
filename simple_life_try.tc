#include pps/library.tc
#include pps/lrblib.tc

// globals

char cell(101*101),dell(101*101),asterisk,space
int work,s,dim
char magenta
int fc // favorite color
int pop // population

birth_death int rp,cp [
 int rw,cw,counter
 rw=rp-1
// no change is default
 dell(dim*rp+cp)=cell(dim*rp+cp)
 while rw<=rp+1 [
  cw=cp-1
  while cw<=cp+1 [
// legal?
   if ((rw>-1)*(rw<dim)*(cw>-1)*(cw<dim)) [
    if (cell(dim*rw+cw)==asterisk) counter=counter+1
    ]
   cw=cw+1
   ]
  rw=rw+1
  ]
// birth?
 if ((cell(dim*rp+cp)==space)) [
  if (counter==3) [dell(dim*rp+cp)=asterisk;pop=pop+1]
  ]
// death?
 else [
  if ((counter<3)+(counter>4)) [dell(dim*rp+cp)=space;pop=pop-1]
  ]
 ]

cycle int foo [
 int r,c,bar
 while r<dim [
  c=0
  while c<dim [
   if foo==0 cell(dim*r+c)=' '
   else [
    if work [
     bar=random(0,1)
     if bar color fc
     else color '7'
     ]
    putchar cell(dim*r+c)
    birth_death r,c
    ]
   c=c+1
   ]
  r=r+1
  if foo==1 [
   pl ""
   ]
  ]
 ]

main [
 int c,rs,cs,delta,gen,gens
 char tcbuff(40)
 getproperty "pps/version.prop","os =",tcbuff,40,"..."
 // work=index(tcbuff,strlen(tcbuff),"Linux",5)
 work=1 // force it
 if work [on;color '4';hilo '1']
 pl "simple_life.try.tc - lrb - 11/11/26"
 magenta='5' // per CL
 if work color '7'
 pl "";pl ""
 asterisk='*';space=' '
 pl "enter dimensions of board e.g. 57 for 57x57 : ";dim=gn
 rs=(dim-1)/2+1 // row start
 pl "enter a number to specify how long the line is e.g. 13 : ";pop=delta=gn
 pl "enter a number between 0 and 9 for seconds to pause between generations : ";s=gn
 pl "what's your favorite color 1=red 2=green 3=yellow 4=blue 5=magenta 6=cyan : ";fc=gn;fc=fc+'0'
 cs=(dim-delta)/2  // column start
// initialize w/ spaces
 cycle 0
// load the row
 c=cs
 while c<cs+delta [
  cell(dim*rs+c)=asterisk
  c=c+1
  ]
 pl "how many generations do you want to see? ";gens=gen=gn
 if work off
 while gen [
  printf("%cgeneration %d population %d%c",10,gens-gen+1,pop,10)
  gen=gen-1
  sleep s
// display and update the array
  cycle 1;strcpy cell,dell
  ]
 if work [on;color '7']
 ]

