#include pps/lrblib.tc
#include pps/library.tc

// graph.try.tc - 6/14/23 - lrb

// changed variable names to p, ps, wps

asterisk int y [ // draw a horizontal line of asterisks using a scale factor
 y = y / scale
 while (y) [
  putchar ('*')
  y = y - 1
  ]
 ]

int scale

main [
 printf ("%cgraph.try.tc - lrb - 11/16/26%c", 10, 10)
 int foo(1000), v(0), debug  // made larger 11/16/26
 int slp // pause in seconds
 printf ("%ctype in a scale factor, e.g. 8 ",10)
 scale = gn()
// debug = 0
 printf ("%ctype in the number of seconds between each bar plotted, e.g. 1 ",10)
 slp = gn ()
 char p(10000), file(30), fnm(30)  // made larger 11/16/26
 int ps, wps
 int nl(1); nl(0) = 10
 strcpy (file, "pop.dat")
 printf ("%cI will graph %s. ", 10, file)
 printf (" Press the Enter key or type in the file name : ")
 gs (fnm)
 if (debug) printf ("%c%d%c", 10, strlen(fnm), 10)
 if (strlen(fnm) == 0) ;
 else strcpy (file, fnm)
 readfile (file, p, 10000) // ditto
 ps = split (foo, p, nl)
 wps = 1 // note 1
 while (wps < ps) [
  pl (" ")
  sleep (slp)  // 11/16/26
  atoi (foo(wps), v)
  pn (wps)
  putchar (' ')
  asterisk (v(0))
  printf (" (%d)", v(0))
  wps = wps + 1
  ]
 pl " "
 ]
