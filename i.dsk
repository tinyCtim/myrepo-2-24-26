170 IF YR > 1699 AND YR < 1800 THEN M = 23: N = 3
180 IF YR > 1799 AND YR < 1900 THEN M = 23: N = 4
190 IF YR > 1899 AND YR < 2100 THEN M = 24: N = 5
200 A = YR MOD 4
210 B = YR MOD 7
220 C = YR MOD 19
230 D = (19 * C + M) MOD 30
240 E = ((2 * A) + (4 * B) + (6 * D) + N) MOD 7
250 OF = 9: MN$ = "April ": IF (D + E) <= OF THEN OF = -22: MN$ = "March "
260 PRINT : PRINT "Easter was / is / will be on " + MN$ + STR$(D + E - OF) + ", " + YEAR$ + "."
270 PRINT : PRINT "Do you wish to try another year? ";
280 AN$ = INKEY$
290 IF AN$ = "" THEN 280
300 IF AN$ = "Y" OR AN$ = "y" THEN GOTO 100
310 PRINT : PRINT "Thank you, please use me again.": PRINT "Peace ..."
320 GOTO 350
330 PRINT : PRINT "Year is out of range!": PRINT "Please enter a year from 1582 to 2099."
340 GOTO 100
350 END
20 GOTO 350
