  int k
  k=getname(fname)
  if ((k==0)+(k==1)) return
  base(0)=n
  base(1)=root
  writefile (fname,base,tr+sb(mxp,mxc),1)
]

reverse char s(4) [ /* reverse string s in place
int c,i,j
i=0;j=strlen(s)-1
while (i<j) [c=s(i);s(i)=s(j);s(j)=c;++i;--j]
]

itoa int n;char nst(4) [ /* convert integer n to string nst
int w
w=0;nst(0)=n%10+'0';n=n/10
while(n) [nst(++w)=n%10+'0';n=n/10]
nst(++w)=0
reverse(nst)  
]

finsert [ /* insert from file
