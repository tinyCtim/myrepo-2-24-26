еееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее
/* wc.c - count characters, words and lines in a text file */

#include <stdio.h>

main (argc,argv) int argc;char **argv;
{
      int fd;
      int nl,nc,nw;
      nl = 0;nc = 0;nw = 0;
      int state;
      state = 0;    
      int c;

      switch (argc - 1)
      {
      case (1):
            break;
      default:
            printf("\nUsage: wc fn.ft\n");
            exit();
      }

      if ((fd = fopen(argv[1],"r")) == NULL)
      {
            printf("Cannot open %s\n",argv[1]);
            exit();
      }

      while ((c = getc(fd)) != EOF)
      {
            ++nc;
            if (c == '\n')
            {   
                  ++nl;++nc;
            }  
            if (c == ' ' || c == '\n' || c == '\t')
                  state = 0;
            else if (state == 0)
            {
                  state = 1;
                  ++nw;
            }
      }

      printf("\n%d lines, %d words, %d characters\n", nl, nw, nc);

}

