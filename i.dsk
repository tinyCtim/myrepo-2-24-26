if(k<-1)return k
t=t+k
if((w=w+k)>l+1)
[pl"Too big"
return -2
]
]
]
writefile char n(0),b(0),e(0)
int u
[int k,t,l
MC(2,n,e-b+1,u,3)
while(b<=e)
[
l=e-b
if(l>127)l=127
