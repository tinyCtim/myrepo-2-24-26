/* see tinyc FB group
/* This program takes answers to revision quiz questions and 
/* writes them to a file.  

getoutfilename char outfile(13)
[
  /* Get name of file where answers will be stored. 
  int i, x 
  char ans(13), data(1)   
  while (x != -1)  
  [
    pl "";ps "Enter filename w/o extension (up to 8 chars)";pl ""
    pl "";ps "Filename --> ";x=gs(ans)
    if (x > 8)
    [
      pl "";ps "Filename too long. Limit 8 characters";pl ""
    ]
    else if (x == 0)
    [
      pl "";ps "No filename entered.";pl ""
    ]
    else
    [
      strcpy(outfile,ans)
      strcat(outfile,".OUT")
      x=readfile(outfile,data,data,1)
      if (x == -1)
      [        
        pl "";ps "Answers will we written to the file ";ps outfile;pl "";pl ""   
      ]
      else
      [
        pl "";ps "File already exists. Enter different filename";pl "" 
      ]      
    ]
  ]  
]

main
[
  /* Take revision quiz answers input by user and write them to a file. 
  pl "";ps "revquiz.tc - rpb - 2/20/2010";pl "";pl ""
  int i, x 
  char q(200), ans(25), outfile(13), data(500)  
  getoutfilename(outfile)     
  strcpy(data,"")
  for (i=1;i<14;++i)
  [  
    if (i == 1)       
      strcpy(q, "Are there any graphics in this post (yes, no)?")           
    else if (i == 2)   
      strcpy(q, "If so, what color does it contain (no graphic, blue, black, red)?")      
    else if (i == 3)
      strcpy(q, "What filetype does it look like it uses (.gif, .jpg, .png)?")    
    else if (i == 4)
      strcpy(q, "How many individuals are mentioned by first name in this article (one, two, three, four, five)?") 
    else if (i == 5)
      strcpy(q, "Which name is not one of them (Roger, Ken, Lee, Amrit)?")
    else if (i == 6)
      strcpy(q, "What obsessive compulsive behaviour is discussed in this paper (writing, reading, revising, dreaming)?")    
    else if (i == 7)
      strcpy(q, "In what programming language was the program that motivated the author to write a split function written (.js, .tc, .pl, .for)?")    
    else if (i == 8)
      strcpy(q, "what's one type of revision the author mentions (spelling, improving, cosmetic, exothermic)?")    
    else if (i == 9)
      strcpy(q, "how many footnotes are provided (zero, one, two)?")    
    else if (i == 10)
      strcpy(q, "which came first: writing split in tiny-c or noticing split was used in a JavaScript program (writing, noticing)?")   
    else if (i == 11)
      strcpy(q, "When was the article last revised (2/14/2010, 2/18/2010, 2/16/2010)?")    
    else if (i == 12)
      strcpy(q, "Which of Bradley's Laws is not illustrated (first, second, third)?")    
    else if (i == 13)
      strcpy(q, "What word is italicized in the article (predicted, predated, updated)?")    
    pl "";ps "Question ";pn i;ps": ";ps q; pl ""      
    pl "";ps "Answer --> ";x=gs(ans)
    if (i != 1)
      strcat(data,"***")    
    if ( x > 0 )        
      strcat(data,ans)             
    else
      strcat(data,"No answer was entered")        
  ]     
  if ((x=writefile(outfile,data,data+strlen(data)-1,1))<0)  
  [
    pl "";ps "error writing output file";pl ""
  ]
  else
  [
    pl "";pl "file ";ps outfile;ps " written.";pl ""
  ] 
]ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее
