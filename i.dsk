ctoh int c;char a(0) [ /* convert byte to 2 hex nibbles
int i,j;i=c/16
for (j=0;j<2;++j) [
  if (i<10) a(j)=i+'0'
  else a(j)=(i-10)+'A'
  i=c%16
  ]
]

rdump char fn(0) [ /* dump file in hex and ascii
char file(15000)
int bytes;if ((bytes=readfile(fn,file,file+15000,1))<0) exit
char a(2),b(1),foo(16)
int i,j,k
cls;pl "Rec ";pn 0;pl "";pl ""
for (i=0;i<bytes;++i) [
  if (i%16==0) [
    if (i) [ps " ";ps foo;strcpy(foo,"");pl ""]
    ++k
    if ((k%17==0)+(k%9==0)) [
      if (k%17==0) [sak;k=1;cls]
      pl "Rec ";pn i/128;pl "";pl ""
      ]
    ]
  b(0)=j=file(i);if (j<0) j=j+256
  if ((b(0)>=' ')*(b(0)<='~')) strcat(foo,b)
  else strcat(foo,".")
  ctoh(j,a);ps a;ps " "
  ]
if ((j=strlen(foo))==16) [ps " ";ps foo]
else if (j) [
  while (j<16) [++j;ps "   "]
  ps " ";ps foo
  ]
