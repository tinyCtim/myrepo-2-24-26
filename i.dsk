/* split char string s delimited by char string delim into int array t

split int t(0);char s(0),delim(0) [
 int y,ix,tx,sl
 int ds
 ds=strlen(delim)
 t(0)=s;sl=strlen(s)
 while (sl-tx) [
  ix=index(s+tx,sl-tx,delim,ds)
  tx=tx+ix+ds-1
  t(++y)=s+tx
  s(tx-ds)=0
  ]
 return y
 ]

