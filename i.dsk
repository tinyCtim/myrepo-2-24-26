/* phonetic.tc - tct - 1/17,18/10

phonetic [ /* translate text into NATO phonetic alphabet

 char text(500),natotext(5000),alphanum(36),wt(1)
 int cp,nato(36)

 nato(1)="Alfa";nato(2)="Bravo";nato(3)="Charlie";nato(4)="Delta";nato(5)="Echo"
 nato(6)="Foxtrot";nato(7)="Golf";nato(8)="Hotel";nato(9)="India";nato(10)="Juliett"
 nato(11)="Kilo";nato(12)="Lima";nato(13)="Mike";nato(14)="November";nato(15)="Oscar"
 nato(16)="Papa";nato(17)="Quebec";nato(18)="Romeo";nato(19)="Sierra";nato(20)="Tango"
 nato(21)="Uniform";nato(22)="Victor";nato(23)="Whiskey";nato(24)="X-ray";nato(25)="Yankee"
 nato(26)="Zulu";nato(27)="Zero";nato(28)="One";nato(29)="Two";nato(30)="Three";nato(31)="Four"
 nato(32)="Five";nato(33)="Six";nato(34)="Seven";nato(35)="Eight";nato(36)="Nine"

 strcpy alphanum,"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

 pl "";ps "phonetic.tc - tct - Sunday, January 17, 2010";pl ""
 pl "";ps "Enter text to translate.";pl "";gs text
 while (strlen(text)) [
  wt(0)=text(0)
  if ((wt(0)>='a')*(wt(0)<='z')) wt(0)=wt(0)-('a'-'A')
  cp=index(alphanum,36,wt,1)
  if (cp==0) strcat(natotext,wt)
  else strcat(natotext,nato(cp))
  strcat(natotext," ")
  strcpy(text,text+1)
  ]
 pl "";ps natotext;pl ""
 ]

