/* 160 P# = POINTS
/* 170 CTR = 0: CTRS = 0
/* 180 FOR SKIP = 1 TO POINTS - 3 STEP 1
/* 190   FOR N = 0 TO POINTS STEP 1
/* 200     W1# = N MOD POINTS
/* 210     W2# = (SKIP + 1) MOD POINTS
/* 220     W3# = W1# * W2#
/* 230     IF W3# >= P# THEN W3# = W3# - P#: GOTO 230
/* 240     IF W3# = POINTS - 1 THEN CTR = CTR + 1
/* 250   NEXT N
/* 260 NEXT SKIP
/* 270 PRINT POINTS, CTR / 2

/* star.tc - 1/26/2008

/* 11/8/2008 - removed <=101 restriction etc.

star [

int ctr,skip,points,n,w1,w2,w3

ctr=0

pl "star.tc - 11/8/2008 - lrb"
pl "";pl "Count your lucky stars!";pl ""
pl "How many points does your star have? ";points=gn

for (skip=1;skip<=(points-3);++skip) [
  for (n=0;n<=points;++n) [
    w1=n%points
    w2=(skip+1)%points
    w3=w1*w2
    while (w3>=points) w3=w3-points
    if (w3==(points-1)) ++ctr
    ] /* for
  ] /* for

pl "There "
char st1(10),st2(10),st3(10)
if (ctr/2>1) [
  strcpy(st1,"are");strcpy(st2,"s");strcpy(st3,"have")
  ]
else [
  strcpy(st1,"is");strcpy(st2,"");strcpy(st3,"has")
  ]
ps st1;pn ctr/2
ps " unique star";ps st2;ps " that ";ps st3;pn points
ps " points."
pl ""

