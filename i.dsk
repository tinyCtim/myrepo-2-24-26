/* tunxis.tc - lrb - 1/23/9, 3/21/11, 6/16/14 */

ceq char s(0),t(0) [
 int i,l;l=strlen(s)
 while ((i<l)*(s(i)==t(i))) ++i
 return i==l
 ]

called int msg(0) [
 char yn;yn=''
 while !((yn=='y')+(yn=='n')+(yn=='Y')+(yn=='N')) [
  pl "Any news? y/n ";yn=gc
  ]
 if ((yn=='n')+(yn=='N')) [
  msg(0)="nonews"
  return
  ]
 yn=''
 while !((yn=='y')+(yn=='n')+(yn=='Y')+(yn=='N')) [
  pl "Did you get the job? y/n ";yn=gc
  ]
 if ((yn=='y')+(yn=='Y')) [
  msg(0)="ubecha"
  return
  ]
 msg(0)="#$!%@"
 ]

hope [
 hilo '1';color '3';pl "tunxis.tc - 1/23/9";pl "";color '7'
 char xfcrossedx(10);int callstring(0)
 xfcrossedx="YES"
 while (ceq(xfcrossedx,"YES")) [
  called(callstring)
  if (ceq(callstring(0),"nonews")) [pl "Keep 'em crossed!";pl ""]
  else if (ceq(callstring(0),"ubecha")) [pl "Excellent!!!";break]
  else [pl "Was not meant to be ...";xfcrossedx="NO"]
  ]
 pl "";hilo '0'
 ]

