]
num char b(5)
int v(0)
[int k
v(0)=0
while(k<5)
[if((b(k)<'0')+(b(k)>'9'))return k
v(0)=10*v(0)+b(k)-'0'
k=k+1
]
return k
]
atoi char b(0)
int v(0)
[int k,s
