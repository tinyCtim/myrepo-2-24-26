	call writs
	pop h
	pop psw
	jnc writ2
	ENDIF	

	IF NOT CPM	;under MARC
	pushוווווווווer
	lhld datap	;compute checksum. get pointer to start of data
	xra a		;clear checksum accumulation
sets3:	add m		;add next bוווווווווe to get length of file to write
	xchg		;put length in DE
