
// globals

char cell(81*81),dell(81*81),asterisk,space
int pop,dim

[
    0123456

 0  x     x   0 0  0 6
 1  xx   xx   1 0  1 1  1 5  1 6
 2  x xxx x   2 0  2 2  2 3  2 4  2 6
 3  x  x  x   3 0  3 3  3 6
]

m [
 int r;r=dim
 int c;c=(dim-1)/2
 cell(dim*(c+0)+c+0)=asterisk
 cell(dim*(c+0)+c+6)=asterisk
 cell(dim*(c+1)+c+0)=asterisk
 cell(dim*(c+1)+c+1)=asterisk
 cell(dim*(c+1)+c+5)=asterisk
 cell(dim*(c+1)+c+6)=asterisk
 cell(dim*(c+2)+c+0)=asterisk
 cell(dim*(c+2)+c+2)=asterisk
 cell(dim*(c+2)+c+3)=asterisk
 cell(dim*(c+2)+c+4)=asterisk
 cell(dim*(c+2)+c+6)=asterisk
 cell(dim*(c+3)+c+0)=asterisk
 cell(dim*(c+3)+c+3)=asterisk
 cell(dim*(c+3)+c+6)=asterisk
 pop=14
 ]

acorn [
 int r;r=dim
 int c;c=(dim-1)/2
 cell(dim*(c+0)+c+1)=asterisk
 cell(dim*(c+1)+c+3)=asterisk
 cell(dim*(c+2)+c+0)=asterisk
 cell(dim*(c+2)+c+1)=asterisk
 cell(dim*(c+2)+c+4)=asterisk
 cell(dim*(c+2)+c+5)=asterisk
 cell(dim*(c+2)+c+6)=asterisk
 pop=7
 ]

glider [
 int r;r=dim
 int c;c=(dim-1)/2
 cell(dim*(c+0)+c+1)=asterisk
 cell(dim*(c+1)+c+2)=asterisk
 cell(dim*(c+2)+c+0)=asterisk
 cell(dim*(c+2)+c+1)=asterisk
 cell(dim*(c+2)+c+2)=asterisk
 pop=5
 ]

birth_death int rp,cp [
 int rw,cw,counter
 rw=rp-1
// no change is default
 dell(dim*rp+cp)=cell(dim*rp+cp)
 while rw<=rp+1 [
  cw=cp-1
  while cw<=cp+1 [
// legal?
   if ((rw>-1)*(rw<dim)*(cw>-1)*(cw<dim)) [
    if (cell(dim*rw+cw)==asterisk) counter=counter+1
    ]
   cw=cw+1
   ]
  rw=rw+1
  ]
// birth?
 if ((cell(dim*rp+cp)==space)) [
  if (counter==3) [dell(dim*rp+cp)=asterisk;pop=pop+1]
  ]
// death?
 else [
  if ((counter<3)+(counter>4)) [dell(dim*rp+cp)=space;pop=pop-1]
  ]
 ]

cycle [
 int r,c
 while r<dim [
  c=0
  while c<dim [
   putchar cell(dim*r+c)
   birth_death r,c
   c=c+1
   ]
  pl ""
  r=r+1
  ]
 ]

init [
 int r,c
 while r<dim [
  c=0
  while c<dim [
   cell(dim*r+c)=space
   c=c+1
   ]
  r=r+1
  ]
 ]

main [
 char datebuff(20)
 int n
 asterisk='*';space=' '
 pl "dimensions of the board e.g. 81 for 81x81 ? ";dim=gn
 init
 int gen,gens
 int s // seconds to delay
 pl "m.tc - lrb - 10/24/26"
 pl "";pl ""
 pl "generations? ";gens=gen=gn
 pl "pause time between generations in seconds? ";s=gn
 pl "1 is a glider 2 is the acorn 3 is the letter m"
 pl "which pattern do you want to run (1..3) ? ";n=gn
 if n==1 glider
 if n==2 acorn
 if n==3 m
 char esc;esc=27
 char lb;lb=91
 putchar esc;putchar lb
 ps "?25l" // hide cursor
 while gen [
  cdate datebuff
  printf "%c%cpopulation: %d generation: %d time: %s%c%c",10,10,pop,gens-gen+1,datebuff,10,10
  gen=gen-1
  sleep s
// display and update the array
  cycle;strcpy cell,dell
  ]
 putchar esc;putchar lb
 ps "?25h" // show cursor
 ]

