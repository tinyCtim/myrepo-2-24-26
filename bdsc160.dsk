	FUNCTION	gets
	call	ma1toh	;get destination addressеееееееееi	e,lf
	call	bdos
	mvi	a,newlin	;and return newline (linefeed)..

gotit:	mov	b,a		;save char in B
	lda	iobrf		;checking forеееееееее
	mvi	m,88h	;Allow a max of about 135 characters
	mvi	c,getlin
	xchg		;put buffer addr in DE
	call	bdos	;get the input lineеееееееееt
	cpi	cntrlc		;control-C ?
	jz	exit		;if so, exit the program.
gotit2:	cpi	1ah		;control-Z ?
	lxi	h,-1		;if so, return -1.еееееееее	b,m	;set B equal to char count
	inx	h	;HL points to first char of line
	pop	d	;DE points to start destination area
copyl:	moеееееееее	;pointer into line where first char is
gcbuff	db	maxl	;max line length fro BDOS 10
gcnum	db	0	;number of characters just readеееееееееstore terminating null
	stax	d
	pop	h	;return buffer address in HL
	pop	b
	ret
	ENDFUNC

;
; Getline(str,lim)
; char *sеееееееееracter ungotten?
	mvi	h,0
	mov	l,a
	ora	a
	rnz		;if so, return true

	lda	nleft	;get number of chars left in buffer
	ora	еееееееее;get max no. of chars
	mov	c,a	;save max length in C
	dcr	c	;allow room for final terminating null
	lxi	d,10	;allow a bit extеееееееее

	ora	a	;0 returned by BDOS if no character ready
	lxi	h,0
	rz		;return 0 in HL if no character ready
	inr	l	;otherwise reеееееееееaddress
	xthl		;push dest addr, get back stack offset
	dad	sp	;allocate space on stack
	push	h	;save buffer address
	mov	m,cеееееееее	ret
	ENDFUNC ungetch

	FUNCTION	putchar
	call	ma1toh	;get character in A
	push	b
	mvi	c,conout
	cpi	newlin	;newline?
	jеееееееееf	;put out a LF
	call	bdos
	pop	h	;get back buffer address
	inx	h	;point to returned char count
	mov	b,m	;set B equal to chaеееееееееov	e,a
	call	bdos

put2:	lda	iobrf	;checking for BREAK characters on keyboard?
	ora	a
	jz	put4	;if not, all done
	
	mvi	cеееееееееopyl:	mov	a,b	;copy line to start of buffer
	ora	a
	jz	gets2
	mov	a,m
	stax	d
	inx	h
	inx	d
	dcr	b
	jmp	copyl
	
gets2:еееееееее;yes. sample it (this will always echo the
	call	bdos	;	character to the screen, alas)
	cpi	cntrlc	;is it control-C?
	jz	exitеееееееее,conin		;get single char from bdos
	call	bdos
	cpi	cr		;carriage return?
	jnz	gotit
	mvi	c,conout	;if so, echo linefeed
	mvеееееееее
	push	b	;save BC
	push	h
	push	h
	lxi	h,-150	;use space below stack for reading line
	dad	sp
	push	h	;save buffer addressеееееееее BREAK character?
	ora	a
	mov	a,b		;restore char into A
	pop	b		;restore BC
	jz	gotit2		;if not checking for BREAK, skip tesеееееееее
	mvi	c,conout
	mvi	e,lf	;put out a LF
	call	bdos
	pop	h	;get back buffer address
	inx	h	;point to returned char count
	movеееееееее
	rz
	mov	l,a		;else return char in HL
	mvi	h,0
	ret

maxl	equ	79	;max length of line of buffered console input
gcptr	ds	2еееееееееv	a,b	;copy line to start of buffer
	ora	a
	jz	gets2
	mov	a,m
	stax	d
	inx	h
	inx	d
	dcr	b
	jmp	copyl
	
gets2:	xra	a	;еееееееее by BDOS 10
gcline	ds	maxl+1	;buffer for characters, in case BDOS 10 is used
	ENDFUNC

	FUNCTION	kbhit
	lda	ungetl	;any chaеееееееееtr;
;
; Gets a line of text from the console, up to 'lim' characters.
;

	FUNCTION	getline
	push	b	;save BC
	call	ma3toh	еееееееееa
	rnz		;if any characters in buffer, return true

	push	b
	mvi	c,cstat	;else interrogate console status
	call	bdos
	pop	bеееееееееra stack for good measure
	dad	d
	call	cmh	;save amount of space to allocate on stack
	push	h
	call	ma3toh	;get destination еееееееееturn 1 in HL
	ret
	ENDFUNC

	FUNCTION	ungetch
	lda	ungetl
	mov	l,a
	push	h
	call	ma2toh
	sta	ungetl
	pop	h
	mvi	h,0
еееееееее	;Set max # of characters
	mvi	c,getlin
	xchg		;put buffer addr in DE
