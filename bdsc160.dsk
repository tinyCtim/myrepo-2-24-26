fgfc2:	call	vfgfdеееееееее	ds	2	;pointer to free storage for use by "sbrk" func
alocmx:	ds	2	;highest location to be made available to the
			;storage aеееееееееd	h	;double it
	dad	h	;4*a
	mov	d,h	;save 4*a in DE
	mov	e,l
