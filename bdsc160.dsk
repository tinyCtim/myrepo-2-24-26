	dad	h	;16*a
	dad	h	;32*a
	dad	d	;36*a
	xchg		;еееееееее	ds	1	;used to save current user number during file I/O
usrnum	ds	1	;set by "setfcu" to user number of given filename

			;Coеееееееее;
