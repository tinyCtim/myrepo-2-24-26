factor int n                                            /* Function used to find the lowest factor for the input number.
[
        int r, d, x, y
        if ( n < 2 )
        [
                r = 0                                   /* Invalid entry. Input number must be between 2 and 32767.
        ]
        else
        [
                x = n / 2
                y = x * 2
                if ( y == n )                           /* Comparison equivalent to using MOD operation
                [
                        r = 2                           /* Lowest factor found. Input number was an even number.
                ]
                else                                    /* Input number is an odd number. Check for an odd number factor.
                [
                        r = n                           /* Assume number is prime. Will be reset if it is not prime.
                        for ( d = 3; d < x; d=d+2 )     /* Skip even numbers. Some non-prime numbers may be interrogated. These will never be the lowest factor.
                        [                               /* The value of x is reduced each time through loop. Effect is equivalent to ending loop at square root of input number.

                                x = n / d
                                y = x * d
                                if ( y == n )           /* Comparison equivalent to using MOD operation
                                [
                                        r = d           /* Lowest factor found
                                        d = x           /* Get out of loop
                                ]
                        ]
                ]
        ]
        return r
]

main                                                    /* Program captures input number and determines lowest factor of that number using factor function
[
        int i, f
        ps "Enter a number between 2 and 32767. ==> ";i = gn
        f = factor i
        if ( f == 0 )
        [
                ps "Must enter a number that is between 2 and 32767.";pl ""
        ]
        else
        [
                ps "Lowest factor of" pn i ps " is:" pn f
                if ( i == f )
                [
                        pl "" ;ps "The number" pn i ps " is a prime number!";pl ""
                ]
                else
                [
                        pl "" ;ps "The number" pn i ps " is NOT a prime number!";pl ""
                ]
        ]
]
