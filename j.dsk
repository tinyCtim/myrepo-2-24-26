/* star.tc - http://primepuzzle.com/tc/tiny-c%20programs.html#64

star [
 int ctr,skip,points,n,w,t;char v(1)
 hilo '1';color '4';pl "star.tc - 12/2/11 - lrb"
 color '7';pl "";pl "Count your lucky stars!"
 ps " How many points does your star have? ";points=gn
 ps "Hit Enter for no details, anything else to see details. Details? "
 w=gs(v)
 for (skip=1;skip<=(points-3)/2;++skip) [
  for (n=1;n<=points;++n) [
   t=n*(skip+1)
   if (t<0) [
    pl "";pl "";pn t;ps " - can't handle this; aborting!";pl "";exit
    ]
   if (!((t+1)%points)) [
    ++ctr
    if (w) [
     pl "";MC ctr,14;ps ". skip =";pn skip;ps " n =";pn n
     ]
    break
  ]]]
 if (w) pl ""
 pl "";MC ctr,14;ps " unique";pn points;ps "-point star(s) found.";pl ""
 hilo '0'
 ]

