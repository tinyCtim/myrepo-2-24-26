Ђѓ{{

/* foxtrot.tc - 2/6,11,12/2010 - tct

split int t(0);char s(0),delim(0) [
 int y,ix,tx,sl
 t(0)=s;sl=strlen(s)
 while (sl-tx) [
  ix=index(s+tx,sl-tx,delim,1)
  tx=tx+ix
  t(++y)=s+tx
  s(tx-1)=0
  ]
 return y
 ]

example [
 /* ROGER ROB KEN MARY LEE AMRIT DO TINYC
 char w(245)
 strcpy(w,"9-15-5-10-9 9-15-8 26-10-20 22-11-9-21 ")
 strcat(w,"6-10-10 11-22-9-13-12 17-15 12-13-20-21-1")
 foxtrot w
 ]

foxtrot char message(0) [
 int t(30),u(100),i,j,n,m,v(0)
 char letter(1),enc(200),let(26),w(245),word(50)
 strcpy(let,"CFUWGLJBREATIZOPDXHNYMSQVK")
 pl "";ps "Please visit http://primepuzzle.com/tc/foxtrot.html";pl "";pl ""
 strcpy(enc,message);strcat(enc," ")
 n=split(t,enc," ")
 for (i=0;i<n;++i) [
  strcpy(word,"")
  strcpy(w,t(i));strcat(w,"-")
  m=split(u,w,"-")
  for (j=0;j<m;++j) [
   atoi(u(j),v)
   letter(0)=let(v(0)-1)
   strcat(word,letter)
   ]
  ps word;ps " "
  ]
 pl ""
 ]

Computer
Journal.  Two such overlays are provided in this package, and we hope that
more will be written by users of ZFILER.  Instructions for installing the
overlays are included with the code.  A nice project for a non-programmer
in the community would be to add comments before each message identifying
when and where each message appears.

     ZF11.CZG    (ZF11.CFG)   Configuration file for use with ZCNFG.COM.
     ZFENG.ZZ0   (ZFENG.Z80)  English-language message overlay source
     ZFGER.ZZ0   (ZFGER.Z80)  German-language message overlay source

Programs --

   You need only one of these "flavors" of ZFILER.  "+" versions support 
ZSDOS and DateStamper date stamps, and show the system time on the status 
line.  They are 4 records longer than the versions that do not support
date stamping.  These versions all use the English-language messages.

     ZF11-R4.CZM    (ZF11-R4.COM)    Reverse video, 4 col
     ZF11-D5.CZM    (ZF11-D5.COM)    Normal video, 5 col
     ZF11-R4+.CZM   (ZF11-R4+.COM)   Rev vid,  4 col, datestamp
     ZF11-R5+.CZM   (ZF11-R5+.COM)   Rev vid,  5 col, datestamp
     ZF11-D4+.CZM   (ZF11-D4+.COM)   Norm vid, 4 col, datestamp
     ZF11-D5+.CZM   (ZF11-D5+.COM)   Norm vid, 5 col, datestamp

   The source code for ZFILER is now being released.  It is in a separate
library called ZF11SRC.LBR.
