/* http://primepuzzle.com/tc/kelsey.tc - 7/8-10/2011 - tct
/* Turn long line into lines of about 72 characters that end in
/* newlines. To use it and turn kelsey.txt into kelsey.out, enter
/* .kelsey "kelsey.txt","kelsey.out"

kelsey char tif(0),tof(0) [
 int i,j,k,br;char ti(2000),to(2000)
 br=readfile tif,ti,ti+1999,1
 while i<br [
  if ((ti(i)==' ')*(k>72)) [to(j)=10;k=0]
  else to(j)=ti(i)
  ++i;++j;++k
  ]
 writefile tof,to,to+j-1,2
 pft to,to+j-1
 ]

