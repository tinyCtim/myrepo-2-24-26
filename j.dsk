/* pal.tc - tct - 10/12/11, 11/7/11

reverse char s(0) [ /* reverse string s in place
 int c,i,j
 i=0;j=strlen(s)-1
 while (i<j) [c=s(i);s(i)=s(j);s(j)=c;++i;--j]
 ]

itoa int n;char nst(0) [ /* convert integer n to string nst
 int w
 w=0;nst(0)=n%10+'0';n=n/10
 while (n) [nst(++w)=n%10+'0';n=n/10]
 nst(++w)=0
 reverse(nst)
 ]

palindrome char s(0) [
 int i,g
 g=strlen(s)
 for (i=0;i<=g/2-1;++i) if (s(i)!=s(g-1-i)) return 0
 return 1
 ]

/* http://primepuzzle.com/tc/tiny-c%20programs.html#51

pal int i [
 ps "pal.tc - tct - 11/7/11"
 char s(7);int n;n=++i
 while (1) [
  itoa n,s
  if (palindrome(s)) [
   pl s;sak
   ]
  ++n
  ]
 ]

