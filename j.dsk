/* meteor.tc - 11/20/08 - lrb

pause int k[int l;while(++l<k)[]]

int speed

star[hilo'1';color'4';posc(1,1)
pl"seed? ";seed=last=gn
speed=2000/random(1,10);posc(3,1);ps"Speed is";pn speed
int k,stars,shoots;posc(4,1)
ps"How many fixed stars do you want? ";stars=gn;posc(5,1)
ps"How many shooting stars do you want? ";shoots=gn
off
while(++k<stars)[
posc(random(1,25),random(1,80));MC(random(' ','~'),1)
pause speed
]
k=0;while(++k<shoots)[color random('1','7');shoot]
color'7';on
]

shoot[int k,start;start=random(20,60);int big
big=random(1,3)*random(1,3)
int delta;delta=random-9,9
while(1)[++k;pause speed
if(!posc(k,start+delta*k))MC'.',1
if(posc(k-big,start+delta*(k-big)))if(k>big)break
MC' ',1
if(big>8)[
if(posc(k-big,start+1+delta*(k-big)))MC' ',1
pause speed
if(posc(k-big,start-1+delta*(k-big)))MC' ',1
pause speed
]
]
] + m*9 + l*20)=l
]]]]

pl ""
int lctr

for (l=100;l>0;--l) [
 if lctr>16 [sak;pl "";pl "";lctr=0]
 pn l
 if ba(l) [
  ++lctr;pf=0;ps " ="
  if wan(l) [pn wan(l);ps " *";pn 6;pf=1]
  if wam(l) [if pf ps " +";pn wam(l);ps " *";pn 9;pf=1]
  if wal(l) [if pf ps " +";pn wal(l);ps " *";pn 20]
  ]
 else [
  bell;pl "";pl "";ps "no solution!";pl "";lctr=lctr+3
  ]
 pl ""
 ]

]

