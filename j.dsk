/* lovers.tc - tct - 2/2/15 */

/* motivated by Nhung Blaschke's C++ assignment */

/* http://primepuzzle.com/tc/lovers.tc */
/* http://primepuzzle.com/karen_armillei/lovers.jpg */

/* B. Nicolт I. Paganini discovered the second smallest */
/* pair when he was 16. */

sumpdiv int m [ /* sum of proper divisors */
 int o,s;s=1
 for (o=2;o<=m/2;++o) [
  if (m%o==0) s=s+o
  ]
 return s
 ]

lovers [
 int i,j,k,l
 pl "Enter lower limit : ";i=gn
 ps "Enter upper limit : ";j=gn
 for (k=i;k<=j;++k) [
  if (k%100==0) ps "." /* show progress */
  if (sumpdiv(l=sumpdiv(k))==k) [
   if (k<l) [
    pl "";pn k;ps " and";pn l;ps " are lovers.";pl ""
 ]]]]

␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀fe.tc - 3/13/2010";pl ""
 pl "";ps "please visit http://primepuzzle.com/tc/life.html";pl ""
 while (b!='q') [
  periodic=pop=0;posc 43,55;ps "gens desired (2:999) ";gen=gn
  ceol;posc 44,1;ps "b/g/l/f/m/a/s/r/w/p/q/? ";bb(0)=b=getchar
  if !((b=='r')+(b=='w')+(b=='p')+(b=='s')) memset cell,dim*dim,' '
  if (b=='b') [blinker;b='p']
  if (b=='g') [glider;b='p']
  if (b=='l') [pl "";ps " line length (3:46) ";l=gn;longline l;b='p']
  if (b=='m') [manual;b='p']
  if (b=='r') [pl "";ps "filename ";gs lifefile;readfile(lifefile,cell,cell+dim*dim-1,1)]
  if (b=='w') [pl "";ps "filename ";gs lifefile;writefile(lifefile,cell,cell+dim*dim-1,1)]
  if (b=='f') [
   for (c=0;c<dim;++c) cell(c)=cell((dim-1)*dim+c)='*'
   for (r=0;r<dim;++r) cell(dim*r)=cell(dim*(r+1)-1)='*'
   b='p'
   ]
  if (b=='a') [
   pl "";ps "Enter a seed number ";slast=last=gn
   if !(last%2) ++last /* make number odd
   seed=last;for (c=0;c<dim*dim;++c) cell(c)=rcell(random (0,1))
   b='p'
   ]
  if (b=='s') [pl "";ps "Enter speed number 1:100 ";p=gn;b='p']
  if (b=='?') [
   pl "";pl "";ps "(b)link (g)lide (l)ine (f)ill (m)anual"
   pl "r(a)ndom (s)peed (r)ead (w)rite (p)lay (q)uit"
   ]
  if (b=='p') [
   off;hilo '1';cls;display;posc 47,55
   ps "gen ";pn 0;ps " population";pn pop
   posc 48,55;ps "speed";pn p;if slast [ps " seed";pn slast]
   pause p;lpop=pop
   for (k=1;k<=gen-1;++k) [
    core;pause p;strcpy cell,dell;display;posc 47,55
    ps "gen";pn k;ps " population";pn pop;ceol
    posc 48,55;ps "speed";pn p;if slast [ps " seed";pn slast]
    if !pop [posc 47,35;color '4';beep 880,5;ps "poof!";break]
    if (pop==lpop) [
     ++periodic;if (periodic==13) [
      color '4';posc 41,55;ps "periodic or static!";break
      ]
     ]
     else [lpop=pop;periodic=1]
    ]
   on;hilo '0';color '7';pl ""
   ]
   if !index("bglfmasrwpq?",12,bb,1) [display;posc 47,55;ps "huh?";ceol]
 ]]

posc int r,c [MC '\'-'A',1;MC '\'-1,1;pos r;MC ';',1;pos c;MC 'H',1]

pos int rc [
 if (rc>9) [MC rc/10+48,1;rc=rc%10]
 MC rc+48,1
 ]

ceol [MC '\'-1-'@',1;MC '\'-1,1;MC 'K',1]

display [
 int i,j;pop=0
 for (i=0;i<dim;++i) [
  for (j=0;j<dim;++j) [
   posc i,j;putchar cell(dim*i+j)
   if (cell(dim*i+j)=='*') ++pop
 ]]]

core [
 int r,c,count
 for (r=0;r<dim;++r) [
  for (c=0;c<dim;++c) [
   count=neighbor(r,c)
   dell(dim*r+c)=cell(dim*r+c) /* default is no change
   if (cell(dim*r+c)=='*') [
    if ((count>3)+(count<2)) dell(dim*r+c)=' '
    ]
   else [
    if (count==3) dell(dim*r+c)='*'
 ]]]]

neighbor int row,col [
 int count
 if !((row-1<0)+(col-1<0)) count=count+(cell(dim*(row-1)+col-1)=='*')
 if !((row-1<0)) count=count+(cell(dim*(row-1)+col)=='*')
 if !((row-1<0)+(col+1>(dim-1))) count=count+(cell(dim*(row-1)+col+1)=='*')
 if !((col-1<0)) count=count+(cell(dim*row+col-1)=='*')
 if !((col+1>(dim-1))) count=count+(cell(dim*row+col+1)=='*')
 if !((row+1>(dim-1))+(col-1<0)) count=count+(cell(dim*(row+1)+col-1)=='*')
 if !((row+1>(dim-1))) count=count+(cell(dim*(row+1)+col)=='*')
 if !((row+1>(dim-1))+(col+1>(dim-1))) count=count+(cell(dim*(row+1)+col+1)=='*')
 return count 
 ]

pause int u [
 int p,q,r
 for (p=0;p<u;++p) [
  for (q=0;q<u;++q) [
   for (r=0;r<u;++r) [;]
 ]]]


/* m6069.tc - lrb - per ceb idea - 9/5,6/2009
/* this only does A's and B's due to tiny-c's inability to handle big files

sixty [ /* not sure why function name s6, e.g., fails ...
 char hi,lo,yellow,white;hi='1';lo='0';yellow='3';white='7'
 char nh20k(40000),m6069(13000)
 char nh20kf(20),nh20kl(150),m6069f(20)
 int i,nh20ks,ix,m6069l,j
 char lf(1);lf(0)=10
 hilo hi;color yellow;pl "m6069.tc - lrb - 9/6/2009";pl "";pl "";color white
 strcpy(nh20kf,"NH20KAB.TXT");strcpy(m6069f,"M6069AB.OUT")
 if ((nh20ks=readfile(nh20kf,nh20k,nh20k+40000,1))>0) [
  while (nh20ks) [
   ix=index(nh20k,nh20ks,lf,1)
   for (j=0;j<ix;++j) nh20kl(j)=nh20k(j)
   nh20kl(j)=0
   ix=index(nh20kl,j,"M 60-69",7)
   if (ix) [
    strcat(m6069,nh20kl)
    m6069l=m6069l+strlen(nh20kl)
    ps nh20kl
    ]
   nh20ks=nh20ks-(ix+1);nh20k=nh20k+(ix+1)
   ]
   if (writefile(m6069f,m6069,m6069+m6069l-1,2)>0) [
    pl "Look at the file ";ps m6069f;pl ""
    ]
  ]
 else [
  pl "file not found"
  ]
 hilo lo
 ]

  if (c > 1)
    x = x + data(i-1)
  if (c < n)
    x = x + data(i+1)
  if (r < n)
  [
    if (c > 1)
      x = x + data(i+n-1)
    x = x + data(i+n)
    if (c < n)
      x = x + data(i+n+1)
  ]
  if (data(i))
  [
    if (x == 2)
      return 1
    else if (x == 3)
      return 1
    return 0
  ]
  else
  [
    if (x == 3)
      return 1
    return 0
  ]
]

main
[
  /* Life simulator
  pl "";ps "life.tc - rpb - 3/8/2010";pl "";pl ""
  int r, c, n, p, i, j, data(1600), hold(1600), occ, gen, mgen, chg
  ps "Enter a seed number. ==> ";last = gn
  pl ""
  if ( last%2 == 0 )
    ++last  /* make number odd
  seed = last
  ps "Enter size of square grid (2 to 40). ==> ";n = gn
  pl ""
  if (n > 40)
    n = 0
  while (n < 2)
  [
    ps "Invalid entry. Enter number between 2 and 40. ==> ";n = gn
    pl ""
    if (n > 40)
      n = 0
  ]
  ps "Enter approx pct of cells to begin as occupied (between 10 and 90). ==> ";p = gn
  pl ""
  if (p > 90)
    p = 0
  while (p < 10)
  [
    ps "Invalid entry. Enter number between 10 and 90. ==> ";p = gn
    pl ""
    if (p > 90)
      p = 0
  ]
  ps "Enter max generations to run (between 1 and 1000). ==> ";mgen = gn
  pl ""
  if (mgen > 1000)
    mgen = 0
  while (mgen < 1)
  [
    ps "Invalid entry. Enter number between 1 and 1000. ==> ";mgen = gn
    pl ""
    if (mgen > 1000)
      mgen = 0
  ]
  cls
  for ( r = 1; r <= n; ++r )
  [
    for ( c = 1; c <= n; ++c )
    [
      data(i) = firstgencellval p
      occ = occ + data(i)
      plot r, c, data(i)
      ++i
    ]
  ]
  if (occ == 0)
  [
    curs n+2,1
    ps "--- Simulation Complete ---";pl ""
    pl "";ps "Civilization never started";pl ""
  ]
  for (j=0;j<25;++j)
    pause 20000
  while (occ)
  [
    for (j=0;j<i;++j)
      hold(j) = data(j)
    i = 0
    occ = 0
    chg = 0
    for ( r = 1; r <= n; ++r )
    [
      for ( c = 1; c <= n; ++c )
      [
        hold(i) = nextgencellval data, i, r, c, n
        occ = occ + hold(i)
        if (data(i) != hold(i))
        [
          plot r, c, hold(i)
          pause 2000
          ++chg
        ]
        ++i
      ]
    ]
    for (j=0;j<i;++j)
      if (data(j) != hold(j))
        data(j) = hold(j)
    if (chg > 0)
    [
      ++gen
      if (occ == 0)
      [
        curs n+2,1
        ps "--- Simulation Complete ---";pl ""
        pl "";ps "The civilization died out between Generations";pn gen-1;ps " and";pn gen;pl ""
      ]
      else if (gen >= mgen)
      [
        curs n+2,1
        ps "--- Simulation Complete ---";pl ""
        pl "";ps "Max Generations of";pn mgen;ps " has been reached";pl ""
        pl "";ps "May they live long and prosper!";pl ""
        occ = 0
      ]
    ]
    else
    [
      curs n+2,1
      ps "--- Simulation Complete ---";pl ""
      pl "";ps "There was no change between Generations";pn gen;ps " and";pn gen+1;pl ""
      pl "";ps "The survivors will live forever!";pl ""
      occ = 0
    ]
    pause 2000
  ]
/* m6069b.tc - lrb - per ceb idea - 9/5,6/2009 - 2/15/2010
/* this only does B's due to tiny-c's inability to handle big files

sixty [ /* not sure why function name s6, e.g., fails ...
 char hi,lo,yellow,white;hi='1';lo='0';yellow='3';white='7'
 char nh20k(16000),m6069(2000)
 char nh20kf(20),nh20kl(150),m6069f(20)
 int i,nh20ks,ix,m6069l,j
 char lf(1);lf(0)=10
 hilo hi;color yellow;pl "m6069b.tc - lrb - 2/15/2010";pl "";pl "";color white
 strcpy(nh20kf,"NH20KB.TXT");strcpy(m6069f,"M6069B.OUT")
 if ((nh20ks=readfile(nh20kf,nh20k,nh20k+16000,1))>0) [
  while (nh20ks) [
   ix=index(nh20k,nh20ks,lf,1)
   for (j=0;j<ix;++j) [nh20kl(j)=nh20k(j)]
   nh20kl(j)=0
   ix=index(nh20kl,j,"M 60-69",7)
   if (ix) [
    strcat(m6069,nh20kl)
    m6069l=m6069l+strlen(nh20kl)
    ps nh20kl
    ]
   nh20ks=nh20ks-(ix+1);nh20k=nh20k+(ix+1)
   ]
/* why does unit need to be 1 to avoid nulls at end of file?
  if (writefile(m6069f,m6069,m6069+m6069l-1,1)>0) [
   pl "Look at the file ";ps m6069f;pl ""
   ]
  ]
 else [
  pl "file not found"
  ]
 hilo lo
 ]

