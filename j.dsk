  int i
  while ((i=strlen(fcon))<fl) fcon(i)=34
  if ((wfl=writefile(nnf,fcon,fcon+fl-1,2))>0) [
    pl nnf;ps" written!";pl""
    ]
  else [
    pl"write failed on ";ps nnf;pl""
    ]
  ]
else [
  pl"read failed on ";ps nf
  ] 
]

