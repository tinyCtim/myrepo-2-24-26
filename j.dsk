fibf int f [
 if (f==0) return 1
 if (f==1) return 1
 return fibf(f-1)+fibf(f-2)
 ]

fib [
 pl "";ps "fib.tc - tct - 4/4/9";pl ""
 int f,i,j
 pl "f? ";f=gn
 i=fibf(f);j=fibf(f-1)
 pl "";pn j/i;ps ".";dpf(j,i,14)
 pl ""
 ]
