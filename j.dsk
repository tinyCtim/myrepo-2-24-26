dpf int n,d,p [
 /* display proper fraction n/d as decimal number */
 /* with p digit precision */
 int w;w=10*n/d
 if p [
  MC w,14 /* print number sans leading space */
  dpf(10*n%d,d,p-1) /* recursive call */
 ]]

peeps [
 int dt,age
 pl "What is your age? ";age=gn
 pl "Figure out how many days there are from now until your birthday."
 pl "Enter that number. ";pl "";pl ""
 dt=gn
 pl "You are";pn age;putchar '.';dpf 365-dt,365,3;ps " years young."
 pl""
 ]

 - tct - 10/12/11"
 char s(7);int n(0);n(0)=++i
 while (1) [
  itoa(n(0),s)
  if (palindrome(s)) [
   pl s;sak
   ]
  n(0)=n(0)+1
  ]
 ]

