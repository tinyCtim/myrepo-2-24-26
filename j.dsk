hello [
 ps"Hello, tiny-c!"
 pl"Good-bye, tiny-c!"
]
-like' string of characters (like 3.14159).
/* Grabs the first character from the input 
/* If this isn't in '0' to '9' range, complains.
/* Converts it to an integer. Adds 1 to the integer.
/* Prints the integer + 1 = x (e.g. 3 + 1 = 4)

pl "3.14159 i love you 365.25 days of da yeah.  Can we have pi 2day?"
pl "";pl "Enter a decimal number like 3.14";pl "";pl ""

char w
int f,x

w=gc
f=1
if (!((w>='0')*(w<='9'))) [pl "The first character in your input must be a digit.";pl "";exit]
x=w-'0'+f
