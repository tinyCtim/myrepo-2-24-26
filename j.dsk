mult [

pl "";hilo '1';color '6';pl "mult.tc version 1.06"
pl "tiny-c program by chip bradley"
pl "prints multiplication table"
pl "for values a,b for (0*0)=0 to (9*9)=81";pl "";color '7'

int a,b,c

for (a=0;a<=9;++a) [
 for (b=0;b<=9;++b) [
  if (!(c%10)) [hilo '0';sak;pl "";pl ""]
  ++c
  hilo '1';pn a;ps" *";pn b;ps" =";pn a*b;pl ""
  ]
 ]
hilo '0';color '7'
]

