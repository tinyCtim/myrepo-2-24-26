/* spit.tc

dpf int n,d,p [
 if p [MC 10*n/d,14;dpf 10*n%d,d,p-1]
 ]

spit [

 int p,e,m,k,w

 for (p=770;p>0;p=p-35) [
  e=e+12
  k=k+9
  m=m+14
  ]

 pn e
 w=35*e/2
 pn w/770;if (w%770) [putchar '.';dpf(w%770,770,1)]

 pn k
 w=35*k/2
 pn w/770;if (w%770) [putchar '.';dpf(w%770,770,1)]

 pn m
 w=35*m/2
 pn w/770;if (w%770) [putchar '.';dpf(w%770,770,1)]

]
