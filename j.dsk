/* mollykew.tc - tct - 10/31/2008

reverse char s(4) [ /* reverse string s in place
int c,i,j
i=0;j=strlen(s)-1
while (i<j) [c=s(i);s(i)=s(j);s(j)=c;++i;--j]
]

itoa int n;char nst(4) [ /* convert integer n to string nst
int w
w=0;nst(0)=n%10+'0';n=n/10
while(n) [nst(++w)=n%10+'0';n=n/10]
nst(++w)=0
reverse(nst)  
]

psq int n [
/* return square root of n if n is a perfect square, else return 0
int m,w
for (m=1;;++m) [
  w=m*m;if (w>n) return 0
  if (w==n) return w
  ]
return 0
]

mollykew [ /* determine and write dance partners 
int j,cnt,k,m,n,d,o
char dstr(5000),nl,wst(4),more
strcpy(dstr,"")
int table(200)
nl=10 /* newline character
char nls(1);nls(0)=nl;nls(1)=0 /* newline string 
char hi,lo,blue,white;hi='1';lo='0';blue='4';white='7'
fopen(2,"dancers.txt",5000,1)
hilo hi;color blue;cls;posc(2,1)
pl "mollykew.tc - lrb - 10/31/2008";hilo lo
pl "";pl ""
more='y'
while (more=='y') [
  ps "Enter number of dancers (18..200): "
  d=gn;d=d/2;d=2*d;pl ""
  pn d /* show progress 
  for (n=1;n<=d;++n) table(n)=0 
  cnt=0
  for (k=(d/2+1);k<=d;++k) [
    for (m=1;m<(d/2+1);++m) [
      if (psq(k+m)*(table(k)==0)*(table(m)==0)) [
        table(k)=m;table(m)=k;++cnt;break
        ] /* if
      ] /* m loop
    ] /* k loop
  if (cnt==d/2) [
    pl "";pl "";pn d;ps " dancers";pl "";pl ""
    strcat(dstr,nls);itoa(d,wst);strcat(dstr,wst)
    strcat(dstr," dancers");strcat(dstr,nls);strcat(dstr,nls)
    for (o=1;o<=d/2;++o) [
      itoa(o,wst);strcat(dstr,wst);strcat(dstr,"-")
      itoa(table(o),wst);strcat(dstr,wst);strcat(dstr," (")
      itoa(psq(o+table(o)),wst);strcat(dstr,wst)
      strcat(dstr,")");strcat(dstr,nls)
      pn o;ps " -";pn table(o);ps " ("
      pn psq(o+table(o));ps " )";pl ""
      ] /* o loop
    sak;pl "";pl ""
    ] 
    else [
      pl"";pl"Can't satisfy requirements; try another number."
      pl"Suggestions: 18,26,50,60,68,86,126,138";pl""    
    ]
    pl "Again (y/n)? ";more=gc
    if ((more>='A')*(more<='Z')) more=more+' '
  ] /* while
  strcat(dstr,nls)
  fwrite(dstr,dstr+strlen(dstr)-1,1);fclose(1)
  pl "";pl "";ps "See file dancers.txt";pl "";exit
]
