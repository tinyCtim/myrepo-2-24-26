SPEEDUP V1.2    Disk Cache Buffer RSX      by H.F.Bower

  Syntax:
	SPEEDUP [d:][s]
  Options:
	d: - Drive letter followed by colon
	s  - Size of cache in K (1-8)
  Defaults:
	Drive is currently logged
	Size is 4K (128 entries)
  Examples:
	SPEEDUP      - Cache 4K of current drive
	SPEEDUP 6    - Cache 6K of current drive
	SPEEDUP D:   - Cache 4K of drive D:
	SPEEDUP C:8  - Cache 8K of drive C:
$
SPEEDUP Loader, V 1.2     by H.F.Bower
$SPEEDUP␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀
/* socks.tc - lrb - 10/16/16 */

/* This program simulates the drawing of single socks from a bureau.   */
/* You specify the number of different colors of socks you have. You   */
/* continue to draw single socks until you have two pairs. e.g. two    */
/* whites and two blues, or four whites. It can been shown that the    */
/* worst case for nc colors is nc+3 socks. If you have 3 colors, you   */
/* need to draw 6 socks to guarantee you have two pair. You need to    */ 
/* draw 19 socks if you have 16 colors to guarantee you have two pair. */

/* The average number of socks you draw to get your two pair is sub-   */
/* stantially fewer than the number that will guarantee you have two   */
/* pair. e.g. the average is about 9 when there are 16 colors.         */

/* We now support bipeds, quadrupeds, flees, spiders                   */ 

/* display proper fraction */

dpfx int n,d,p [if p [MC 10*n/d,14;dpfx 10*n%d,d,p-1]]

dpf int n,d,p [putchar '.';dpfx n,d,p]

/* random number generator */

int last,seed /* globals */

random int low, high [

 int range
 if(last==0) last=seed=99
 range=high-low+1
 if (last>=1073741824) last=last-1 /* to get around tc arithmetic bug
 last=last*seed
 if (last<0) last= 0-last
 return low+(last/7)%range

 ]

socks [

 pl "http://primepuzzle.com/tc/socks.tc - lrb - 10/16/16";pl "" 

 /* socks arrays, socks picked, max socks picked, matched pair count */

 int fa(200),sa(200)
 int sp,msp,mpc,i,j
 int nc /* number of "colors" */
 int total /* total socks picked */
 int ns /* number of simulations */
 int ex,ap /* exponent, what constitutes "a pair" */

 pl "Number of colors : ";nc=gn
 pl "Number of simulations : 1 for 10, 2 for 100, ..., 4 for 10000 etc. : "
 ex=gn
 ns=1;for (i=1;i<=ex;++i) [ns=ns*10]
 pl "What constitutes a pair?"
 pl "Humans have 2 feet, dogs have 4, flees have 6, spiders have 8 : ";ap=gn
 pl "Seed the random number generator with some odd number like 31 or 271 : "
 last=seed=gn;pl "";ps "Calculating ...";pl "";pl ""
  
 for (i=1;i<=ns;++i) [ /* number of simulations */

  mpc=0 /* initialize stuff */
  for (j=1;j<=nc;++j) sa(j)=0
  sp=0

  while (mpc<2) [ /* loop while matched pair count is less than 2 */

   ++sp /* bump socks picked */
   ++sa(random(1,nc)) /* add 1 to a random bucket */
   
   for (j=1;j<=nc;++j) [
    if (sa(j)==ap) [ /* when pair found */
     ++mpc;sa(j)=0 /* bump matched pair count and clear bucket */
    ]]

   if (sp>msp) msp=sp /* update max socks picked */

   ] 

   ++fa(sp) /* update frequency array */
   total=total+sp /* keep track of total socks pulled */

  ]

 ps "Maximum number of socks picked was";pn msp;ps "."
 pl "Total socks picked was";pn total;ps "."
 pl "Number of simulations was";pn ns;ps "."
 pl "Average number of socks picked was";pn total/ns;dpf(total%ns,ns,4);ps "."
 pl "";pl ""
 for (j=2*ap;j<=msp;++j) [pn j;ps " :";pn fa(j);pl ""]

 ]


