/* kfc.tc - 1/17/9 - lrb

kfc [ /* convert tah K and C frum F (holee peecez onwy please!)
  int f,c
  pl "Kentucky Fried Celsius, vershun 273.15. Wee lyke id Kold!"
  pl "Yur order, in degrees F (holee peecez onwy pleaze): ";f=gn
  ps "Dat wud be (approx.)";pn (c=(5*f-160)/9);ps " in Celsius"
  ps " or, if u prefer,";pn (c+273);ps " in Kentucky."
  pl "Temperatures in Mayne, Mazzachozits and Connecticut may vary."
  pl ""
  ]
