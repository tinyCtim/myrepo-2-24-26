/* genwurd.tc - tct - 2/27/2011

/* generates up to 600 random "words" consisting of
/* up to 11 capital letters

/* these words can be sorted by tree.ipl

gw char wurd(0) [
 int i,wl,j
 j='Z'-'A'
 wl=random 1,11
 for (i=0;i<wl;++i) wurd(i)='A'+random 0,j
 wurd(wl)=0
 ]

genwurd [
 char wurdf(600*11),nl(1),wurd(11)
 int i,wl,nw
 nl(0)=10
 pl "seed : ";last=gn;seed=last
 pl "how many wurds? (2 to 600) ";nw=gn;++nw;pl ""
 while (--nw) [
  gw wurd
  strcat wurd,nl;strcat wurdf,wurd
  ]
 writefile("wurds.txt",wurdf,wurdf+strlen(wurdf)-1,1)
 ]

";pl "";pl ""
 strcpy(enc,message);strcat(enc," ")
 n=split(t,enc," ")
 for (i=0;i<n;++i) [
  strcpy(word,"")
  strcpy(w,t(i));strcat(w,"-")
  m=split(u,w,"-")
  for (j=0;j<m;++j) [
   atoi(u(j),v)
   letter(0)=let(v(0)-1)
   strcat(word,letter)
   ]
  ps word;ps " "
  ]
 pl ""
 ]

