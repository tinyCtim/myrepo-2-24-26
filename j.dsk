/* tinyc.tc */

pmc int m;char c [
 while (--m>-1) putchar c
 ]

tinyc [
 int i,st(31)
 st(0)="tinyc.tc - 11/22/2013 - tct";st(1)="tiny-c from a to z"
 st(2)="plus a little";st(3)="BASIC";st(4)="C"
 st(5)="C++"
 st(6)="FORTRAN"
 st(7)="Haskell"
 st(8)="HTML";st(9)="Java";st(10)="JavaScript"
 st(11)="Karel"
 st(12)="Mouse"
 st(13)="Pascal";st(14)="Perl";st(15)="PHP";st(16)="Python"
 st(17)="Scala"
 st(18)="tiny"
 st(19)="by";st(20)="TcT";st(21)="http://primepuzzle.com/tc"
 pl ""
 for (i=0;i<=21;++i) [
  pmc((80-strlen(st(i)))/2,' ');ps st(i);pl ""
  ]
 ]

