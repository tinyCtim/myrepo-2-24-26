/* rollem.tc - 2/21/15 - tct */

rollem char player(0);int score(0),limit [
 int i,toss
 score(0)=0
 pl player;ps"'s turn";pl"";pl""
 for (i=0;i<=limit;++i) [
  pn(toss=random(1,6));ps""
  score(0)=score(0)+toss
  ]
 pl "score is:";pn score(0)
 ]

main [
 int score(0),limit,lscore,hscore
 int lwins,hwins,i,ng
 lwins=hwins=0
 pl"seed? ";seed=gn
 pl"number of games? ";ng=gn
 for (i=0;i<ng;++i) [ 
  limit=2
  rollem("Lee",score,2);lscore=score(0)
  if lscore<11 [
   limit=3;rollem("Lee",score,2)
   lscore=score(0)
   ]
  pl"";rollem("Hal",score,limit);hscore=score(0)
  pl"";if (lscore>hscore) [
   pl"Lee wins";lwins=lwins+1
   ]
  else [
   pl"Hal wins";hwins=hwins+1
   ]
  ] 
  pl"Lee won ";pn lwins;ps " games." 
  pl"Hal won ";pn hwins; ps " games."
 ]

