/* md.tc - 2/15/15 - tct */

ctoh int c;char a(0) [
 int i
 i=c/16;if (i<10) a(0)=i+'0';else a(0)=(i-10)+'a'
 i=c%16;if (i<10) a(1)=i+'0';else a(1)=(i-10)+'a'
 ]

md [
 pl "md.tc - 2/15/15 - tct"
 int s1,s2,s3,s4,m1,m2,m3,m4,i,bytes
 char b,a(8)
 m1=3;m2=7;m3=13;m4=23
 char where(5000),fn(20)
 pl "Enter file to process : ";gs fn
 bytes=readfile fn,where,where+5000,1
 while (i<bytes) [
  b=where(i)
  s1=(s1+b*m1)%256;
  s2=(s1+s2+b*m2)%256;
  s3=(s1+s2+s3+b*m3)%256;
  s4=(s1+s2+s3+s4+b*m4)%256;
  ++i
  ]
 ps "MD value is: "
 ctoh s1,a;ctoh s2,a+2;ctoh s3,a+4;ctoh s4,a+6
 ps a
 ]

