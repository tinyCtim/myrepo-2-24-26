/* For example, if the day's high temperature is 60 */
/* and the low is 40, the average temperature is 50 */
/* degrees. 65 minus 50 is 15 heating degree days. */

/* Cooling degree days are also based on the day's */
/* average minus 65. They relate the day's temperature */
/* to the energy demands of air conditioning. */

/* For example, if the day's high is 90 and the day's */
/* low is 70, the day's average is 80. 80 minus 65 is */
/* 15 cooling degree days. */

/* heating degree days cooling degree days program */

hddcdd [
 int h,l,w
 pl "hddcdd.tc - c. bradley - 8/25/14";pl ""
 ps "hi temp for yesterday: ";h=gn
 ps "low temp for yesterday: ";l=gn
 w=65-(h+l)/2
 if (w>0) [ps "heating degree days";pn w]
 else if (w<0) [ps "cooling degree days";pn -w]
 else ps "no heating or cooling degree days"
 ]

