5$V!b9-Ѕл4'Ct·"–Љ^є_|љUПzРeMрlЅ%Н`Зие±Рl~оA„ЪбѕТпЦјЃzВ(<LEJOFaЬkЈцо„‘Ъf!ҐsGpШW'ш™ЉD+дОAЛAЯxrµUxжBqЎ4n‹б«Фaё&?…W%ёлV0ЬqЙ=ЩььгE"бў41j3␀BҐ±S§©р?лiRHС•†8фЋ)-Ѕл4:K{R(®(‚ѓцYсPЫЕЧПў)'ylГJ™q¶іТ°VЬ%бЫA2=l>S[Е*пЗ(™—hУЭ Аs*Ш*>±у*бХnKЇ4ЅTл±№UBѓ xЪEG>Jў10dЈW±™R^ЃЯ?а	␀i␀м
/* morse.tc - 9/29/2012 - tag, sbg, lrb */

int speed

dot [beep(440,2);pause]

dash [beep(440,6);pause]

pause [int k;while ((k=k+1)<speed) []]

space [int r;while ((r=r+1)<20) []]

dotdash char d(0) [
 int e;char c
 while (c=d(e)) [
  if (c=='.') dot;else dash;e=e+1
 ]]

letnum char c [
 pause;int k
 while ((k=k+1)<speed) pause
  if (c=='a') dotdash ".-"
  else if (c=='b') dotdash "-..."
  else if (c=='c') dotdash "-.-."
  else if (c=='d') dotdash "-.."
  else if (c=='e') dotdash "."
  else if (c=='f') dotdash "..-."
  else if (c=='g') dotdash "--."
  else if (c=='h') dotdash "...."
  else if (c=='i') dotdash ".."
  else if (c=='j') dotdash ".---"
  else if (c=='k') dotdash "-.-"
  else if (c=='l') dotdash ".-.."
  else if (c=='m') dotdash "--"
  else if (c=='n') dotdash "-."
  else if (c=='o') dotdash "---"
  else if (c=='p') dotdash ".--."
  else if (c=='q') dotdash "--.-"
  else if (c=='r') dotdash ".-."
  else if (c=='s') dotdash "..."
  else if (c=='t') dotdash "-"
  else if (c=='u') dotdash "..-"
  else if (c=='v') dotdash "...-"
  else if (c=='w') dotdash ".--"
  else if (c=='x') dotdash "-..-"
  else if (c=='y') dotdash "-.--"
  else if (c=='z') dotdash "--.."
  else if (c==' ') [pause;pause;pause]
  else if (c=='0') dotdash "-----"
  else if (c=='1') dotdash ".----"
  else if (c=='2') dotdash "..---"
  else if (c=='3') dotdash "...--"
  else if (c=='4') dotdash "....-"
  else if (c=='5') dotdash "....."
  else if (c=='6') dotdash "-...."
  else if (c=='7') dotdash "--..."
  else if (c=='8') dotdash "---.."
  else if (c=='9') dotdash "----."
 ]

morse char s(0) [
 speed=400
 while (s(0)) [
  letnum s(0);s=s+1
 ]]

morsev char s(0) [ /* verbose morse */
 char quiet
 ps "speed? ";speed=gn
 while (s(0)) [
  if (s(0)=='/') quiet=1-quiet /* toggle */
  putchar s(0)
  if (1-quiet) letnum s(0)
  s=s+1
 ]]

morsef [ /* morse a file */
 char name(20),where(1001);int bytes
 ps "enter name of file : ";gs name
 bytes=readfile(name,where,where+1001,1)
 morsev where
 ]

practice [
 char c;int k,n,r,s
 ps "how many letters? ";k=gn
 ps "how many repeats? ";r=gn
 ps "speed? ";speed=gn
 ps "seed? ";seed=last=gn
 while ((n=n+1)<=k) [
  c=random 'a','z';s=0
  while ((s=s+1)<=r) letnum c
  letnum ' ';putchar c;putchar ' '
 ]]

foo [
 morsev "tinyc rocks"
 ]

