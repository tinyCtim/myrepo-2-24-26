/* gow5b.tc - tct - 3/4,5,24/11
/* display words found in a file on separate lines
/* usage: .words "filename.typ"
/* http://primepuzzle.com/tc/gow5b.tc

white char c [return (c==' ')+(c==10)+(c==13)+(c==9)]

words char godmanf(0) [char godman(6000);int nc,c,i
 nc=readfile godmanf,godman,godman+6000-1,1
 while (i<nc) [
  while !white(c=godman(i)) [putchar c;++i]
  pl "";while white(godman(++i)) ;
 ]]

