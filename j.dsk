/* dell.tc - 9/3/9 - lrb - from http://www.yofx.org/?p=327

dell [
 pl "";hilo '1';color '3';ps "dell.tc - lrb - 9/3/9";pl "";color '7' 
 int c,r,a,b,d,k,n,s,e
 for (c=1;c<10;++c) [
 for (r=1;r<10;++r) [
 if (r==c) ++r
 if (r==10) break
 for (a=1;a<10;++a) [
 while ((a==r)+(a==c)) ++a
 if (a==10) break
 for (b=1;b<10;++b) [
 while ((b==a)+(b==r)+(b==c)) ++b
 if (b==10) break
 for (d=1;d<10;++d) [
 while ((d==b)+(d==a)+(d==r)+(d==c)) ++d
 if (d==10) break
 for (k=1;k<10;++k) [
 while ((k==d)+(k==b)+(k==a)+(k==r)+(k==c)) ++k
 if (k==10) break
 for (n=1;n<10;++n) [
 while ((n==k)+(n==d)+(n==b)+(n==a)+(n==r)+(n==c)) ++n
 if (n==10) break
 for (s=1;s<10;++s) [
 while ((s==n)+(s==k)+(s==d)+(s==b)+(s==a)+(s==r)+(s==c)) ++s
 if (s==10) break
 e=45-(c+r+a+b+d+k+n+s)
 if (c+r+a+b==17)
 if (d+a+r+k==20)
 if (b+r+a+n==14)
 if (r+a+k+e==18)
 if (b+a+n+k==18)
 if (d+a+d+a==24)
 if (b+a+n+d==21)
 if (s+e+e+d==24) [
  beep 160,3
  pl " c r a b d k n s e";pl""
  pn c;pn r;pn a;pn b;pn d;pn k;pn n;pn s;pn e
  pl "";sak;pl ""
  ]
 ]]]]]]]]
 pl ""
 ]

