/* star.tc - 1/26/2008

star [
int ctr,skip,points,n,w1,w2,w3
pl "Count your lucky stars!";pl ""
pl "How many points (<= 101 please) does your star have? ";points=gn
for (skip=1;skip<=(points-3);++skip) [
  for (n=0;n<=points;++n) [
    w1=n%points
    w2=(skip+1)%points
    w3=w1*w2
    while (w3>=points) w3=w3-points
    if (w3==(points-1)) ++ctr
    ]
  ]
  pl "There are";pn ctr/2
  ps " unique stars that you can draw which have";pn points;ps " points."
  pl ""
]

