/* mult.tc - lrb - 3/13/2010

mult [ /* print multiplication tables from 1*1 up to 12*12
 int i,j
 pl "mult.tc - 3/13/2010 - lrb"
 for (i=1;i<=12;++i) [
  pl "";sak;pl ""
  for (j=1;j<=12;++j) [
   pl "";pn i;ps " *";pn j;ps " ="
   pn i*j
   ]
  ]
 pl ""
]

