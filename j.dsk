11 CALL CMD(FOOBAR$)
13 IF LEN(FOOBAR$)<>0 THEN 29
17 PRINT "Usage : MOTYL YOUR VERY OWN COMMAND TAIL";
19 GOTO 37
29 FBL=LEN(FOOBAR$) : FBL$=STR$(FBL) : FBL$=MID$(FBL$,1,LEN(FBL$))
31 PRINT FOOBAR$ : PRINT "The length of the command tail was" FBL$ "."
37 END
