factor int f [
 ps "factor.tc - 8/29/2014 - tct";pl ""
 int s,p(999),idx,j,pc
 p(0)=2;p(1)=3;p(2)=5;idx=2;pc=7
 while (idx<999) [ /* load primes */
  for (j=0;p(j)*p(j)<p(idx);++j) if (!(pc%p(j))) break
  if pc%p(j) p(++idx)=pc
  pc=pc+2
  ]
 while ((s<1000)*(f!=1)) [ /* factor number */
  if !(f%p(s)) [pn p(s);f=f/p(s);if f!=1 ps " *"]
  else ++s
  ]
 if f!=1 [ps "I can't factor this number. Sorry :("]
 ]

