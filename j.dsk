pn int n [MC n,14]

decimal [
 int n,d
 ps "n ? ";n=gn
 ps "d ? ";d=gn
 pn n;ps "/";pn d;ps "="
 pn n/d;ps "."
 dpf n%d,d,11
]

dpf int n,d,p [
 if p [pn 10*n/d;dpf 10*n%d,d,p-1]
]
