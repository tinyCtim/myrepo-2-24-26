•2Iµо0О€иа0ґЧM;OЪ5%©V,Ь/PN·EаО6mћ9вVќ7#ёр‡0ЊёМp9PЃК`TрпmDѓЩ9xп7Ц8nB3ЌНъ9‡R°с‰ЌE‰Ј«ђ3jHПd␀8€2С7SЖ…¤Ђ—’␀&є№йДЂiкёќЈi8c§ЧB–Ъ№Б–ћ н›0йц©¶Ј dЇXЁу«А:Нгn2ҐЧњI2ё4fіUУi•у␀ЋЈђЭ~ЌГ4ћ‡dХЌќhi–з—	0qГ9Роґu7Тd=5ЖХ…KdR7PВ;#L	Жf. ЛјTхAУT/* gow2.tc - 2/1/2011 */
main [ int a(6),k,i,j,r(2),flag
 ps "gow2.tc";pl "enter 7 numbers";pl ""
 for (i=0;i<7;++i) a(i)=gn
 for (k=0;k<6;++k) [
  if a(k)!=999 [
   flag=0;for (i=k+1;i<7;++i) [
    if a(k)==a(i) [a(i)=999;flag=1]    
    ]
   if flag==1 [r(j)=a(k);++j]
   ]
  ]
 ps "repeaters follow"
 while (--j>=0) [pl "";pn r(j)]
 ]
