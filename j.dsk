/* multseq.tc - lrb - 5/3/12

/* Please visit http://primepuzzle.com/tc/multseqtxt.html for a discussion
/* of this program.

/* This program computes 3^9999-3*9999. For background, see
/* http://primepuzzle.com/tc/sequence.html.

subtract int a(0),b(0),d [ /* 9's complement arithmetic
/* this function destroys the contents of the b array
 int i;
 for (i=0;i<=d;++i) b(i)=9-b(i);
 add(a,b,d);b(d)=1;
 for (i=0;i<d;++i) b(i)=0;
 add(a,b,d);
 ]

add int a(0),b(0),d [
 int i,c,w;
 for (i=0;i<=d;++i) [
  w=a(d-i)+b(d-i)++c;a(d-i)=w%10;c=w/10;
 ]]

multiply int a(0),m,d [
 int i,c,w;
 for (i=0;i<=d;++i) [
  w=a(d-i)*m+c;a(d-i)=w%10;c=w/10;
 ]]

multseq [
 pl "multseq.tc - 5/3/12 - tct";
 int a(5000),b(5000),i,j,d,k;
 pl "enter the number 50, 500 or 5000: ";d=gn;
 k=d/5;
 a(d)=3;
 for (i=0;k>=1;++i) [b(d-i)=9;k=k/10;]
 multiply(b,3,d);
 for (i=0;i<=2*d-3;++i) [
  pn i;pl "";
  multiply(a,3,d);
  ]
 subtract(a,b,d);
 i=0;while (a(i)==0) ++i;
 j=i;putchar(7);
 pl "The";pn d-i+1;ps " digit value is";pl "";sak;
 while i<=d [
  putchar('0'+a(i));++i;
  if ((i-j)%110==0) pl "";
  ]
 pl ""
 ]

