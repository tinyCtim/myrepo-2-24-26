/* foxtrot.tc - rpb - 2/9/2010

/* see tiny-c Facebook group

/* This program takes a cryptic numeric code entered by the
/* user and converts it to the corresponding text message.

split int t(0);char s(0),delim(0)
[
  int y,ix,tx,sl
  t(0)=s;sl=strlen(s)
  while (sl-tx)
  [
    ix=index(s+tx,sl-tx,delim,1)
    tx=tx+ix
    t(++y)=s+tx
    s(tx-1)=0
  ]
 return y
]

decoder int n(0)
[
  /* Function used to convert number to corresponding letter.
  char c
  int v(0)
  atoi(n,v)
  c = '?'  /* Invalid number will appear as a question mark
  if (v(0) == 0)
    c = ' '  /* The number zero and alpha entries will appear as a space
  if (v(0) == 1)
    c = 'C'
  if (v(0) == 2)
    c = 'F'
  if (v(0) == 3)
    c = 'U'
  if (v(0) == 4)
    c = 'W'
  if (v(0) == 5)
    c = 'G'
  if (v(0) == 6)
    c = 'L'
  if (v(0) == 7)
    c = 'J'
  if (v(0) == 8)
    c = 'B'
  if (v(0) == 9)
    c = 'R'
  if (v(0) == 10)
    c = 'E'
  if (v(0) == 11)
    c = 'A'
  if (v(0) == 12)
    c = 'T'
  if (v(0) == 13)
    c = 'I'
  if (v(0) == 14)
    c = 'Z'
  if (v(0) == 15)
    c = 'O'
  if (v(0) == 16)
    c = 'P'
  if (v(0) == 17)
    c = 'D'
  if (v(0) == 18)
    c = 'X'
  if (v(0) == 19)
    c = 'H'
  if (v(0) == 20)
    c = 'N'
  if (v(0) == 21)
    c = 'Y'
  if (v(0) == 22)
    c = 'M'
  if (v(0) == 23)
    c = 'S'
  if (v(0) == 24)
    c = 'Q'
  if (v(0) == 25)
    c = 'V'
  if (v(0) == 26)
    c = 'K'
  return c
]

main
[
  /* Convert cryptic numbers entered by user to reveal secret message.
  pl "";ps "foxtrot.tc - rpb - 2/9/2010";pl "";pl ""
  int i, x, t(500)
  char m, msg(500)
  pl "";ps "Enter numeric code, separate each number with a dash";pl "";pl ""
  pl "";ps "Code --> ";x=gs(msg)
  if ( x > 0 )
  [
    if (msg(x-1) != '-')
      strcat(msg, "-")
    x = split(t,msg,"-")
    pl "";pl "";ps "Secret message: "
    for ( i = 0;i < x; ++i )
    [
      m = decoder(t(i))
      putchar m
    ]
  ]
  else
  [
    pl "";pl "";ps "No code was entered";pl ""
  ]
]

