/* grade.tc - rpb - 2/26/2010
/* see tinyc FB group
/* This program grades the revquiz.

dpf int n,d,p
[ /* display proper fraction n/d w/ p decimal digit precision
  int w
  w=10*n/d
  if (p)
  [
    MC w,14
    dpf 10*n%d,d,p-1 /* recursive call
  ]
]

split int t(0);char s(0),delim(0)
[
  int y,ix,tx,sl,ds
  ds=strlen(delim)
  t(0)=s;sl=strlen(s)
  while (sl-tx)
  [
    ix=index(s+tx,sl-tx,delim,ds)
    tx=tx+ix+ds-1
    t(++y)=s+tx
    s(tx-ds)=0
  ]
  return y
]

ceq char s(0),t(0)
[ /* returns 1 if strings are equal else returns 0
  int slen,tlen,i
  slen = strlen(s)
  tlen = strlen(t)
  if ( slen == tlen )
  [
    for (i=0;i<slen;++i)
      if ( s(i) != t(i) )
        return 0
    return 1
  ]
  else
    return 0
]

getquizdata char ansfile(12),data(500)
[
  /* Get data from file. If no file name passed, prompt from name of file.
  int x
  char ans(12)
  while (strlen(data) == 0)
  [
    if (strlen(ansfile) == 0)
    [
      pl "";ps "Enter filename w/o extension for quiz to grade";pl ""
      pl "";ps "Filename --> ";x=gs(ans)
      if (x > 8)
      [
        pl "";ps "Filename too long. Limit 8 characters";pl ""
      ]
      else if (x == 0)
      [
        pl "";ps "No filename entered.";pl ""
      ]
      else
      [
        strcpy(ansfile,ans)
        strcat(ansfile,".OUT")
      ]
    ]
    if (strlen(ansfile) > 0)
    [
      x=readfile(ansfile,data,data+500,1)
      if (x == -1)
      [
        pl "";ps "File not found. Enter different filename.";pl ""
        strcpy(ansfile, "")
      ]
    ]
  ]
]

main
[
  /* Grade answers to revision quiz based on correct answers.
  pl "";ps "grade.tc - rpb - 2/26/2010";pl "";pl ""
  int c, i, x, correct(500), compare(500)
  char filenm(12), correctdata(500), comparedata(500)
  strcpy(correctdata,"")
  strcpy(comparedata,"")
  strcpy(filenm, "ANSWERS.OUT")
  getquizdata(filenm, correctdata)
  strcpy(filenm, "")
  getquizdata(filenm, comparedata)
  x = split( compare, comparedata, "***")
  x = split( correct, correctdata, "***")
  for ( i = 0; i < x; ++i )
  [
    c = c + ceq(compare(i),correct(i))
  ]
  pl "";ps "Total Correct:   ";pn c;pl ""
  pl "";ps "Total Questions: ";pn x;pl ""
  c = c * 100
  pl "Grade =";pn c/x;ps ".";dpf(c%x,x,2)
  pl ""
]

