/* testr.tc

int las,see
rand int low,high[int range;if(!las)las=see=99
range=high-low+1;las=las*see
if(las<0)las=-las
return (low+(las/8)%range)
]

testr [
int i,j,a(10)
pl "seed? ";see=las=gn
for (i=1;i<1001;++i) [
  j=rand(1,10)
  pn j
  a(j)=a(j)+1
  ]
for (i=1;i<11;++i) [
  pl "";pn a(i)
  ]
pl ""  
]

