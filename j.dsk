/* math.tc - 1/7/9 - lrb - from amy merritt

/* (ab)^2 = cab   what's c?

math [
  pl "";hilo '1';color '3';ps "math.tc - lrb - 1/7/9";pl "";color '7' 
  int a,b,c
  for (a=1;a<10;++a) [
    for (b=0;b<10;++b) [
      for (c=1;c<10;++c) [
        if (100*a*a+20*a*b+b*b==100*c+10*a+b) [
          pl "a =";pn a;ps " b =";pn b;ps " c =";pn c
          pl ""
          pl "100*a*a+20*a*b+b*b ="
          pn 100*a*a;ps " +";pn 20*a*b;ps " +";pn b*b;ps " ="
          pn 100*a*a+20*a*b+b*b
          ps " = 100*c+10*a+b ="
          pn 100*c;ps " +";pn 10*a;ps " +";pn b
          ]
        ]
      ]
    ]
    pl ""
  ]

m6069l+strlen(nh20kl)
    ps nh20kl
    ]
   nh20ks=nh20ks-(ix+1);nh20k=nh20k+(ix+1)
   ]
