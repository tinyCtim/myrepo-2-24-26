’¦пОur№зqд%w.geлTи_‰“V¶GєI0с‚LЃ…w3Џyf€Жvj:®P,?™Ч–ХађКТЉ"ќQХ-{Ъ S5aU мј320#<9Z[3Ъj1t tІ"џMU5ІЂГ•KM'ЬЪ«цµ№U®сwW!„‹“ћ8*—;Ы$Эpeі¶Ђ))vЂ&±и)/* gow3.tc - 2/1/2011 */
main [
 char s(50),t(50),a(50),w(1)
 int sl,tl,i,j,k
 ps "gow3.tc"
 pl "enter 2 strings ";pl ""
 sl=gs s;tl=gs t
 for (i=0;i<sl;++i) [
  w(0)=s(i)
  if !index(a,strlen(a),w,1)*index(t,tl,w,1) [a(k)=w(0);++k]
  ]
 ps "letters common to both strings follow";pl a
 ]
ny wurds? (2 to 600) ";nw=gn;++nw;pl ""
 while (--nw) [
  gw wurd
  strcat wurd,nl;strcat wurdf,wurd
  ]
 writefile("wurds.txt",wurdf,wurdf+strlen(wurdf)-1,1)
 ]

