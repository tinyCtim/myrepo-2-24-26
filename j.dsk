ca-А€В›»ќЊР2/* fortest.tc - lrb - 12/19/2007
fortest [ /* note need not to name this function fortest (not!)
  int i
  for (i=0;i<5;i=i+1) [pl "";pn i;ps " is less than";pn (i+1)]
  pl ""
]
e into memory */
 if ((cnt=readfile(f,where,where+21000,1))>0) [
 /* loop while linefeeds are detected */
  while ((ix=index(where,cnt,lfs,1))) [
 /* print a line */
   pft where,where+ix-1
 /* next search will start at beginning of next line */
   where=where+ix
   cnt=cnt-ix /* decrement the count of characters to search */
 /* force user to hit Enter every 20 lines */
   if (++lines>19) [sak;pl "";pl "";lines=0]
   ]
  ]
 ]

