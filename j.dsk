/* http://en.wikipedia.org/wiki/Euclidean_algorithm

/* gcd.tc

gcd int a,b [
 if (b==0)
  return a
 else
  return gcd b,a%b
]

main [
 pl "";ps "the gcd of 1071 and 462 is";pn gcd 1071,462;pl ""
 ]

