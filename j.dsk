/* addcr.tc - lrb - 7/25/16 */

/* made CP/M tiny-c compliant */

addcr [ /* add carriage returns in front of linefeeds */

 char nf(20),onf(20),fcon(10000),f1con(10000);int nfl,onfl,i,j,fl,wfl

 pl "addcr.tc - lrb - 7/25/16, 9/2/16"
 pl "add carriage returns in front of linefeeds"

 while (nfl==0) [pl"";pl"input file? ";nfl=gs(nf)]
 while (onfl==0) [ps"output file? ";onfl=gs(onf)]

 fl=readfile(nf,fcon,fcon+9999,1)
 pn fl;ps " characters in input file"

 while (i<fl) [
  if (fcon(i)==10) [f1con(j)=13;j=j+1]
  f1con(j)=fcon(i);j=j+1
  i=i+1
  ]

 /* note final parameter in next function call must be a */
 /* 1 in CP/M version! */

 wfl=writefile(onf,f1con,f1con+j-1,1)
 pl "";pn wfl;ps " characters in output file"
 pl "";pn wfl-fl;ps " carriage returns added"

 ]

