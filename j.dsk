/* gow1.tc - 2/2/2011 */

min int v(0),i,j [ int w
 if v(i)>v(j) [w=v(j);v(j)=v(i);v(i)=w]
 ]

main [
 int n(2),w
 ps "gow1.tc"
 pl "enter 3 numbers ";pl ""
 n(0)=gn;n(1)=gn;n(2)=gn
 min(n,0,1);min(n,0,2);min(n,1,2)
 ps "total =";pn n(0)+n(1)+n(2)
 pl "numbers in order =";pn n(0);pn n(1);pn n(2)
 ]
 y
]

decoder int n(0)
[
  /* Function used to convert number to corresponding letter.
  char c
  int v(0)
  atoi(n,v)
  c = '?'  /* Invalid number will appear as a question mark
  if (v(0) == 0)
    c = ' '  /* The number zero and alpha entries will appear as a space
  if (v(0) == 1)
    c = 'C'
  if (v(0) == 2)
    c = 'F'
  if (v(0) == 3)
    c = 'U'
  if (v(0) == 4)
    c = 'W'
  if (v(0) == 5)
    c = 'G'
  if (v(0) == 6)
    c = 'L'
  if (v(0) == 7)
    c = 'J'
  if (v(0) == 8)
    c = 'B'
  if (v(0) == 9)
    c = 'R'
  if (v(0) == 10)
    c = 'E'
  if (v(0) == 11)
    c = 'A'
  if (v(0) == 12)
    c = 'T'
  if (v(0) == 13)
    c = 'I'
  if (v(0) == 14)
    c = 'Z'
  if (v(0) == 15)
    c = 'O'
  if (v(0) == 16)
    c = 'P'
  if (v(0) == 17)
    c = 'D'
  if (v(0) == 18)
    c = 'X'
  if (v(0) == 19)
    c = 'H'
  if (v(0) == 20)
    c = 'N'
  if (v(0) == 21)
    c = 'Y'
  if (v(0) == 22)
    c = 'M'
  if (v(0) == 23)
    c = 'S'
  if (v(0) == 24)
    c = 'Q'
  if (v(0) == 25)
    c = 'V'
  if (v(0) == 26)
    c = 'K'
  return c
]

main
[
  /* Convert cryptic numbers entered by user to reveal secret message.
  pl "";ps "foxtrot.tc - rpb - 2/9/2010";pl "";pl ""
  int i, x, t(500)
  char m, msg(500)
  pl "";ps "Enter numeric code, separate each number with a dash";pl "";pl ""
  pl "";ps "Code --> ";x=gs(msg)
  if ( x > 0 )
  [
    if (msg(x-1) != '-')
      strcat(msg, "-")
    x = split(t,msg,"-")
    pl "";pl "";ps "Secret message: "
    for ( i = 0;i < x; ++i )
    [
      m = decoder(t(i))
      putchar m
    ]
  ]
  else
  [
    pl "";pl "";ps "No code was entered";pl ""
  ]
]

