/* dir.tc - tct */

dir [
 pl "";ps "dir.tc";pl "";pl ""
 char where(18000),lfs(1);int cnt,ix,lines
 lfs(0)=10
 if ((cnt=readfile("dir.txt",where,where+18000,1))>0) [
  while ((ix=index(where,cnt,lfs,1))>0) [
   pft where,where+ix-1
   where=where+ix
   cnt=cnt-ix
   if (++lines>19) [pl "";pl "";lines=0]
 ]]]

