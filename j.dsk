/* gsplpn.tc - lrb - original by ceb - 1/14/9

gsplpn [

/* Print an introductory message.
/* Reads a 'pi-like' string of characters (like 3.14159).
/* Determines the integer to the left of the decimal point. 
/* If what's read isn't "pi-atable" (i.e. "compatable w/ pi"), 
/* prints "Decimal number (examples ...) required" and exits.
/* Adds 1 to the integer.
/* Prints the integer + f = x (e.g. 3 + 1 = 4)

pl "3.14159 i love you 365.25 days of da yeah.  Can we have pi 2day?"
pl "";pl "Enter a decimal number like 3.14";pl "";pl ""

char w(5)
int f,x,d
int i(0)

gs w
f=1
d=atoi(w,i)
if (!d) [pl "Decimal number (like 3.141 or 100.12) required.";pl"";exit]
x=i(0)+f
pl "";pn i(0);ps " +";pn f;ps " =";pn x;pl ""

]
turn 0
]

getquizdata char ansfile(12),data(500)
[
  /* Get data from file. If no file name passed, prompt from name of file.
  int x
  char ans(12)
  while (strlen(data) == 0)
  [
    if (strlen(ansfile) == 0)
    [
      pl "";ps "Enter filename w/o extension for quiz to grade";pl ""
      pl "";ps "Filename --> ";x=gs(ans)
      if (x > 8)
      [
        pl "";ps "Filename too long. Limit 8 characters";pl ""
      ]
      else if (x == 0)
      [
        pl "";ps "No filename entered.";pl ""
      ]
      else
      [
        strcpy(ansfile,ans)
        strcat(ansfile,".OUT")
      ]
    ]
    if (strlen(ansfile) > 0)
    [
      x=readfile(ansfile,data,data+500,1)
      if (x == -1)
      [
        pl "";ps "File not found. Enter different filename.";pl ""
        strcpy(ansfile, "")
      ]
    ]
  ]
]

main
[
  /* Grade answers to revision quiz based on correct answers.
  pl "";ps "grade.tc - rpb - 2/26/2010";pl "";pl ""
  int c, i, x, correct(500), compare(500)
  char filenm(12), correctdata(500), comparedata(500)
  strcpy(correctdata,"")
  strcpy(comparedata,"")
  strcpy(filenm, "ANSWERS.OUT")
  getquizdata(filenm, correctdata)
  strcpy(filenm, "")
  getquizdata(filenm, comparedata)
  x = split( compare, comparedata, "***")
  x = split( correct, correctdata, "***")
  for ( i = 0; i < x; ++i )
  [
    c = c + ceq(compare(i),correct(i))
  ]
  pl "";ps "Total Correct:   ";pn c;pl ""
  pl "";ps "Total Questions: ";pn x;pl ""
  c = c * 100
  pl "Grade =";pn c/x;ps ".";dpf(c%x,x,2)
  pl ""
]

