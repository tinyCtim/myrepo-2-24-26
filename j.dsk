/* xms.tc - lrb - 1/2012

char nl(1)

pls char ls(0) [ /* print long string
 int i,j
 i=j=0
 while (i<strlen(ls)) [
  putchar ls(i)
  ++i;++j
  if ((j>61)*(ls(i)==' ')) [ps nl;j=0;++i]
 ]]

xmascript [
 int sp_dev(9),sp_dev_i,sp_dev_fl(9),i

 nl(0)=10;nl(1)=0

 sp_dev(9)="Samsung Sliding PC 7"
 sp_dev(8)="Motorola Xoom"
 sp_dev(7)="HTC Flyer"
 sp_dev(6)="Samsung Galaxy Tab 8.9"
 sp_dev(5)="B&N Nook Color"
 sp_dev(4)="ASUS Eee Pad Transformer"
 sp_dev(3)="BlackBerry PlayBook"
 sp_dev(2)="The Amazon tablet"
 sp_dev(1)="HP TouchPad"
 sp_dev(0)="Apple iPad 2"

 sp_dev_fl(9)="A Windows 7 tablet that is legitimately intriguing is Samsung's Sliding PC 7."
 sp_dev_fl(8)=""
 strcat(sp_dev_fl(8),"When Google is ready to make a leap forward with Android, it anoints a hardware")
 strcat(sp_dev_fl(8)," partner to work closely with the company on the new software and produce a device")
 strcat(sp_dev_fl(8)," that will be an initial concept vehicle of what Google envisions.") 
 sp_dev_fl(7)=""
 sp_dev_fl(6)=""
 sp_dev_fl(5)=""
 sp_dev_fl(4)=""
 sp_dev_fl(3)=""
 sp_dev_fl(2)=""
 sp_dev_fl(1)=""
 sp_dev_fl(0)=""

 pl ""
 for (i=9;i>=0;--i) [pn i;ps " ";ps sp_dev(i);ps nl]
 pl "";ps "What tablet did you secretly want (0-9) ? ";sp_dev_i=gn
 pl "";pls sp_dev_fl(sp_dev_i)
 pl ""
 ]

