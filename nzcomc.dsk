 jmp mceset
;
mc1001 callеееееееееardy and inch, and HOLDF is a flag
;indicating whether or not a char is in HOLD.
chrdy mvi c,chcon ;check the console status
еееееееееor later
 call entry
 mov e,a ;result -> DE
 mvi d,0
 pop h ;fnum -> L
 mov a,l
 cpi 27 ;only function 27 returns 2 bytesеееееееееhi bit
 sta hold
 xra a ;set holdf to -1
 dcr a
 sta holdf
tryhold lda holdf ;test hold flag
