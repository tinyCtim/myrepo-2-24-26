	DB	LCFIX + 'n'
	DB	Lеееееееее	ADD	E
	MOV	E,A
	MOV	A,B
	ADC	D
	MOV	D,A
	ORA	E	;Z now set. CY cleared.
	MOV	A,D
	RLC		;Sign is now in CY, Z not hurt.
	еееееееееX + 'h'
	DB	LCFIX + 'i'
